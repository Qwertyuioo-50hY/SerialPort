<UserControl
    x:Class="Tomography.TitleBar.WindowTitleBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="42" FontSize="12">
    <UserControl.Resources>
        <Style TargetType="MenuFlyoutPresenter">
            <Setter Property="MinWidth" Value="240" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="4" />
        </Style>
    </UserControl.Resources>
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="M" Modifiers="Control" Invoked="MenuAcceleratorInvoked" />
        <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="ParametersAcceleratorInvoked" />
    </UserControl.KeyboardAccelerators>
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftInset" Width="0" />
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="42" />
            <ColumnDefinition x:Name="RightInset" Width="0" />
        </Grid.ColumnDefinitions>
        <Button x:Name="AppIcon" AutomationProperties.AutomationId="MainMenu" Grid.Column="2" Width="32" Height="32"
                Background="Transparent" BorderThickness="0" Padding="8"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                AutomationProperties.Name="显示或隐藏顶部菜单" ToolTipService.ToolTip="主菜单 · Ctrl+M" Click="ToggleMenus">
            <Viewbox Width="20" Height="20"><Grid Width="24" Height="24">
                <Path Fill="{ThemeResource TextFillColorPrimaryBrush}" Data="M9 20q-.825 0-1.412-.587T7 18t.588-1.412T9 16t1.413.588T11 18t-.587 1.413T9 20m6 0q-.825 0-1.412-.587T13 18t.588-1.412T15 16t1.413.588T17 18t-.587 1.413T15 20m-6-6q-.825 0-1.412-.587T7 12t.588-1.412T9 10t1.413.588T11 12t-.587 1.413T9 14m6 0q-.825 0-1.412-.587T13 12t.588-1.412T15 10t1.413.588T17 12t-.587 1.413T15 14M9 8q-.825 0-1.412-.587T7 6t.588-1.412T9 4t1.413.588T11 6t-.587 1.413T9 8m6 0q-.825 0-1.412-.587T13 6t.588-1.412T15 4t1.413.588T17 6t-.587 1.413T15 8" />
            </Grid></Viewbox>
        </Button>
        <Button x:Name="ModeSelector" Grid.Column="2" Grid.ColumnSpan="2" HorizontalAlignment="Left" Visibility="Collapsed" VerticalAlignment="Center"
            CornerRadius="8" Padding="8,3" Click="CycleMode" ToolTipService.ToolTip="点击切换 EMT / EIT / ECT"
            AutomationProperties.AutomationId="ModeSelector">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border CornerRadius="4" Padding="4,2" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock x:Name="ModeIcon" Text="EMT" FontSize="11" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <TextBlock x:Name="ModeLabel" Text="电磁层析成像" VerticalAlignment="Center" />
                <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
        <MenuBar x:Name="Menus" AutomationProperties.AutomationId="TopMenus" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Left"
                 Background="Transparent" AccessKey="M">
            <MenuBarItem FontSize="12" Title="文件(F)" AccessKey="F">
                <MenuFlyoutItem Text="新建项目" KeyboardAcceleratorTextOverride="Ctrl+N" />
                <MenuFlyoutSubItem Text="导入">
                    <MenuFlyoutItem Text="导入项目" IsEnabled="False" />
                    <MenuFlyoutItem Text="导入自定义算法" Tag="ImportAlgorithm" Click="MenuClicked" />
                    <MenuFlyoutItem Text="导入数据" Tag="ImportData" Click="MenuClicked">
                        <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="O" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="导入灵敏度矩阵" Tag="ImportSensitivity" Click="MenuClicked" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSubItem Text="导出">
                    <MenuFlyoutItem Text="导出采集数据（CSV）" Tag="ExportAcquisitionCsv" Click="MenuClicked" />
                    <MenuFlyoutItem Text="导出采集数据（MAT）" Tag="ExportAcquisitionMat" Click="MenuClicked" />
                    <MenuFlyoutItem Text="导出重建矩阵（CSV）" Tag="ExportMatrix" Click="MenuClicked" />
                    <MenuFlyoutItem Text="导出重建图像（BMP）" Tag="ExportImage" Click="MenuClicked" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="另存为" Tag="ExportFile" Click="MenuClicked">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="S" Modifiers="Control,Shift" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSubItem Text="最近的项目"><MenuFlyoutItem Text="暂无最近项目" IsEnabled="False" /></MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="设置">
                    <MenuFlyoutItem Text="设备采集参数" IsEnabled="False" />
                    <MenuFlyoutItem Text="重建输入状态" IsEnabled="False" />
                    <ToggleMenuFlyoutItem x:Name="RealtimeItem" Text="实时二维重建" Tag="ToggleRealtimeReconstruction" Click="ViewToggleClicked" />
                    <MenuFlyoutItem Text="空场采集" IsEnabled="False" />
                    <MenuFlyoutItem Text="检查自定义 Python 语法" Tag="CheckPythonSyntax" Click="MenuClicked" />
                    <MenuFlyoutItem Text="重建" Tag="RunReconstruction" Click="MenuClicked" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="保存" KeyboardAcceleratorTextOverride="Ctrl+S" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="关闭" KeyboardAcceleratorTextOverride="Ctrl+W" />
                <MenuFlyoutItem Text="退出登录" />
                <MenuFlyoutItem Text="退出" KeyboardAcceleratorTextOverride="Ctrl+Q" />
            </MenuBarItem>
            <MenuBarItem FontSize="12" Title="视图(V)" AccessKey="V">
                <MenuFlyoutItem Text="工具窗口" Tag="ToggleTools" Click="MenuClicked" />
                <MenuFlyoutSubItem Text="外观">
                    <ToggleMenuFlyoutItem Text="测量波形" IsChecked="True" Tag="ToggleWaveform" Click="ViewToggleClicked" />
                    <ToggleMenuFlyoutItem Text="数据表格" IsChecked="True" Tag="ToggleData" Click="ViewToggleClicked" />
                    <ToggleMenuFlyoutItem Text="二维重建图像" IsChecked="True" Tag="ToggleReconstruction" Click="ViewToggleClicked" />
                    <ToggleMenuFlyoutItem Text="摄像头" IsChecked="True" Tag="ToggleCamera" Click="ViewToggleClicked" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="显示/隐藏侧边栏" Tag="ToggleSidebar" Click="MenuClicked" KeyboardAcceleratorTextOverride="Ctrl+Shift+B">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="B" Modifiers="Control,Shift" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <ToggleMenuFlyoutItem x:Name="ParametersItem" Text="显示/隐藏参数面板" IsChecked="True" Click="ToggleParameters" KeyboardAcceleratorTextOverride="Ctrl+B" />
                <MenuFlyoutItem Text="显示/隐藏底部面板" Tag="ToggleBottom" Click="MenuClicked" KeyboardAcceleratorTextOverride="Ctrl+J">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="J" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="显示/隐藏导航面板" Tag="ToggleProject" Click="MenuClicked" KeyboardAcceleratorTextOverride="Ctrl+Shift+E">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="E" Modifiers="Control,Shift" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="放大" Tag="ZoomIn" Click="MenuClicked" KeyboardAcceleratorTextOverride="Ctrl++">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="Add" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="缩小" Tag="ZoomOut" Click="MenuClicked" KeyboardAcceleratorTextOverride="Ctrl+-">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="Subtract" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="实际大小" Tag="ZoomReset" Click="MenuClicked" KeyboardAcceleratorTextOverride="Ctrl+0">
                    <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="Number0" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem FontSize="12" Title="指令(I)" AccessKey="I">
                <MenuFlyoutItem Text="连接设备" Tag="ConnectDevice" Click="MenuClicked" />
                <MenuFlyoutSubItem Text="采集数据">
                    <MenuFlyoutItem Text="采集一帧数据" IsEnabled="False" />
                    <MenuFlyoutItem Text="多次采集" IsEnabled="False" />
                    <MenuFlyoutItem Text="实时采集" IsEnabled="False" />
                </MenuFlyoutSubItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="启动聊天" Tag="OpenChat" Click="MenuClicked" />
                <MenuFlyoutItem Text="打开后台" Tag="OpenConsole" Click="MenuClicked" />
                <MenuFlyoutSubItem x:Name="CustomCommands" Text="添加命令">
                    <MenuFlyoutItem Text="添加命令…" Tag="AddCommand" Click="MenuClicked" />
                    <MenuFlyoutSeparator />
                </MenuFlyoutSubItem>
            </MenuBarItem>
            <MenuBarItem FontSize="12" Title="自定义(C)" AccessKey="C">
                <MenuFlyoutItem Text="自定义API" Tag="ConfigureApi" Click="MenuClicked" />
                <MenuFlyoutItem Text="自定义算法" Tag="ConfigureAlgorithm" Click="MenuClicked" />
                <MenuFlyoutItem Text="波形图像" Tag="ConfigureWaveform" Click="MenuClicked" />
            </MenuBarItem>
            <MenuBarItem FontSize="12" Title="帮助(H)" AccessKey="H">
                <MenuFlyoutItem Text="快捷键" Tag="Help" AutomationProperties.AutomationId="MenuHelp" Click="MenuClicked" />
            </MenuBarItem>
        </MenuBar>
    </Grid>
</UserControl>
