<UserControl x:Class="Tomography.UI.Bottom.AiChatPanelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><Style x:Key="ChatBubbleStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/></Style></UserControl.Resources>
 <Border Style="{StaticResource WorkspaceCardStyle}" CornerRadius="24">
  <Grid RowSpacing="16" Margin="8,16,8,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="4"><TextBlock x:Name="ConversationTitle" Text="新对话" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ModelLabel" Text="尚未配置模型" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="ChatModel"/></StackPanel>
   <Grid Grid.Row="1">
    <ListView x:Name="Messages" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Hidden" AutomationProperties.AutomationId="ChatMessages"/>
    <TextBlock x:Name="EmptyMessage" Text="开始新的对话" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Grid>
   <TextBlock x:Name="ChatStatus" Grid.Row="2" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="ChatStatus"/>
   <Border Grid.Row="3" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="24" Padding="16,12">
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="MessageInput" PlaceholderText="输入消息…" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="160" Background="Transparent" BorderThickness="0" CornerRadius="16" AutomationProperties.Name="聊天消息" AutomationProperties.AutomationId="ChatInput"/>
     <Button x:Name="SendButton" Grid.Column="1" Click="SendClicked" Width="36" Height="36" CornerRadius="18" Padding="0" VerticalAlignment="Bottom" Background="{ThemeResource TextFillColorPrimaryBrush}" Foreground="{ThemeResource LayerFillColorDefaultBrush}" AutomationProperties.Name="发送消息" AutomationProperties.AutomationId="SendChatMessage"><FontIcon Glyph="&#xE74A;" FontSize="18"/></Button>
    </Grid>
   </Border>
  </Grid>
 </Border>
</UserControl>
