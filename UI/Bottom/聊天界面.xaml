<UserControl x:Class="Tomography.UI.Bottom.AiChatPanelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="ChatEffortAccentBrush" Color="#FFBE92"/></ResourceDictionary>
    <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="ChatEffortAccentBrush" Color="#984C25"/></ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="ChatEffortAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/></ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Style x:Key="ChatBubbleStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/></Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Border Style="{StaticResource WorkspaceCardStyle}" CornerRadius="24">
  <Grid RowSpacing="16" Margin="8,16,8,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="ConversationTitle" Text="新对话" FontSize="20" FontWeight="SemiBold"/>
   <Grid Grid.Row="1">
    <ListView x:Name="Messages" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Hidden" AutomationProperties.AutomationId="ChatMessages"/>
    <TextBlock x:Name="EmptyMessage" Text="开始新的对话" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Grid>
   <TextBlock x:Name="ChatStatus" Grid.Row="2" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="ChatStatus"/>
   <Border Grid.Row="3" MaxWidth="920" HorizontalAlignment="Stretch" Margin="16,0" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="24" Padding="8,6">
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Click="NewConversationClicked" Width="32" Height="32" CornerRadius="16" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="新建对话" AutomationProperties.AutomationId="ComposerNewChat"><FontIcon Glyph="&#xE710;" FontSize="18"/></Button>
     <TextBox x:Name="MessageInput" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="32" MaxHeight="160" Background="Transparent" BorderThickness="0" BorderBrush="Transparent" CornerRadius="16" VerticalAlignment="Center" TextChanged="MessageInputChanged" KeyDown="MessageInputKeyDown" AutomationProperties.Name="聊天消息" AutomationProperties.AutomationId="ChatInput">
      <TextBox.Resources>
       <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
       <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
       <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
       <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent"/>
       <SolidColorBrush x:Key="TextControlBackground" Color="Transparent"/>
       <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent"/>
       <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent"/>
       <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent"/>
       <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
       <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
      </TextBox.Resources>
     </TextBox>
     <Button Grid.Column="2" x:Name="ModelButton" Background="Transparent" BorderThickness="0" CornerRadius="16" Padding="10,6" VerticalAlignment="Center" AutomationProperties.Name="模型和思考设置" AutomationProperties.AutomationId="ChatModelSettings">
      <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="ModelLabel" FontSize="12" FontWeight="SemiBold" Text="选择强度" VerticalAlignment="Center"/><FontIcon Glyph="&#xE70D;" FontSize="10"/></StackPanel>
      <Button.Flyout>
       <Flyout x:Name="ModeFlyout" Opened="ModeFlyoutOpened" Placement="Top">
        <Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter"><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="12"/><Setter Property="Background" Value="{ThemeResource DevicePageBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource DeviceDividerBrush}"/><Setter Property="BorderThickness" Value="1"/></Style></Flyout.FlyoutPresenterStyle>
        <StackPanel Width="208" Spacing="6">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE945;" FontSize="18" VerticalAlignment="Top"/>
          <TextBlock x:Name="EffortHeading" Grid.Column="1" Text="中等" Foreground="{ThemeResource ChatEffortAccentBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
          <Button Grid.Column="2" Click="ResetEffortClicked" Padding="6" Background="Transparent" BorderThickness="0" AutomationProperties.Name="恢复默认强度" AutomationProperties.AutomationId="ResetChatEffort"><FontIcon Glyph="&#xE777;" FontSize="16"/></Button>
         </Grid>
         <Grid Height="36">
         <Slider x:Name="EffortSlider" Minimum="0" Maximum="4" StepFrequency="1" SnapsTo="StepValues" TickPlacement="None" ValueChanged="EffortValueChanged" AutomationProperties.Name="思考强度" AutomationProperties.AutomationId="ChatEffort">
          <Slider.Resources>
           <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
             <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFBE92"/><SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFBE92"/><SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFBE92"/></ResourceDictionary>
             <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="SliderTrackValueFill" Color="#984C25"/><SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#984C25"/><SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#984C25"/></ResourceDictionary>
             <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource SystemColorHighlightColor}"/></ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="SliderTrackThemeHeight">22</x:Double><x:Double x:Key="SliderHorizontalHeight">36</x:Double>
            <CornerRadius x:Key="SliderTrackCornerRadius">11</CornerRadius><CornerRadius x:Key="SliderThumbCornerRadius">14</CornerRadius>
            <x:Double x:Key="SliderHorizontalThumbWidth">28</x:Double><x:Double x:Key="SliderHorizontalThumbHeight">28</x:Double>
            <x:Double x:Key="SliderInnerThumbWidth">0</x:Double><x:Double x:Key="SliderInnerThumbHeight">0</x:Double>
           </ResourceDictionary>
          </Slider.Resources>
         </Slider>
          <Grid Margin="14,0" IsHitTestVisible="False"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Ellipse x:Name="EffortDot0" Grid.Column="0" Width="4" Height="4" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.4" VerticalAlignment="Center"/>
           <Ellipse x:Name="EffortDot1" Grid.Column="2" Width="4" Height="4" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.4" VerticalAlignment="Center"/>
           <Ellipse x:Name="EffortDot2" Grid.Column="4" Width="4" Height="4" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.4" VerticalAlignment="Center"/>
           <Ellipse x:Name="EffortDot3" Grid.Column="6" Width="4" Height="4" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.4" VerticalAlignment="Center"/>
           <Ellipse x:Name="EffortDot4" Grid.Column="8" Width="4" Height="4" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.4" VerticalAlignment="Center"/>
          </Grid>
         </Grid>
        </StackPanel>
       </Flyout>
      </Button.Flyout>
     </Button>
     <Button x:Name="SendButton" Grid.Column="3" Click="SendClicked" Width="30" Height="30" MinWidth="0" MinHeight="0" CornerRadius="15" Padding="0" VerticalAlignment="Center" Background="{ThemeResource ComposerSendBackground}" Foreground="{ThemeResource ComposerSendForeground}" BorderThickness="0" AutomationProperties.Name="发送消息" AutomationProperties.AutomationId="SendChatMessage"><Button.Resources>
      <ResourceDictionary>
       <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="ComposerSendBackground" Color="#E6E6E6"/><SolidColorBrush x:Key="ComposerSendForeground" Color="#202020"/><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#E6E6E6"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E6E6E6"/><SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#E6E6E6"/><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#202020"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="#202020"/><SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#202020"/></ResourceDictionary>
        <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="ComposerSendBackground" Color="#202020"/><SolidColorBrush x:Key="ComposerSendForeground" Color="#FFFFFF"/><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#202020"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#202020"/><SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#202020"/><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF"/><SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FFFFFF"/></ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="ComposerSendBackground" Color="{ThemeResource SystemColorButtonFaceColor}"/><SolidColorBrush x:Key="ComposerSendForeground" Color="{ThemeResource SystemColorButtonTextColor}"/><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SystemColorButtonFaceColor}"/><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SystemColorButtonFaceColor}"/><SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{ThemeResource SystemColorButtonFaceColor}"/><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{ThemeResource SystemColorButtonTextColor}"/><SolidColorBrush x:Key="ButtonForegroundPressed" Color="{ThemeResource SystemColorButtonTextColor}"/><SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{ThemeResource SystemColorButtonTextColor}"/></ResourceDictionary>
       </ResourceDictionary.ThemeDictionaries>
      </ResourceDictionary>
     </Button.Resources><Grid><FontIcon x:Name="SendArrow" Glyph="&#xE74A;" FontSize="16"/><Rectangle x:Name="ThinkingSquare" Width="10" Height="10" RadiusX="1" RadiusY="1" Fill="{ThemeResource ComposerSendForeground}" Visibility="Collapsed"/></Grid></Button>
    </Grid>
   </Border>
  </Grid>
 </Border>
</UserControl>
