<UserControl x:Class="Tomography.UI.Bottom.AiChatPanelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><Style x:Key="ChatBubbleStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/></Style></UserControl.Resources>
 <Border Style="{StaticResource WorkspaceCardStyle}" CornerRadius="24">
  <Grid RowSpacing="16" Margin="8,16,8,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="ConversationTitle" Text="新对话" FontSize="20" FontWeight="SemiBold"/>
   <Grid Grid.Row="1">
    <ListView x:Name="Messages" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Hidden" AutomationProperties.AutomationId="ChatMessages"/>
    <TextBlock x:Name="EmptyMessage" Text="开始新的对话" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Grid>
   <TextBlock x:Name="ChatStatus" Grid.Row="2" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="ChatStatus"/>
   <Border Grid.Row="3" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="28" Padding="12,12,12,8">
    <Grid RowSpacing="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBox x:Name="MessageInput" PlaceholderText="与 AI 协作" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="200" Background="Transparent" BorderThickness="0" CornerRadius="16" AutomationProperties.Name="聊天消息" AutomationProperties.AutomationId="ChatInput"/>
     <Grid Grid.Row="1" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Click="NewConversationClicked" Width="36" Height="36" CornerRadius="18" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="新建对话" AutomationProperties.AutomationId="ComposerNewChat"><FontIcon Glyph="&#xE710;" FontSize="18"/></Button>
      <Button Grid.Column="2" Click="OpenSettingsClicked" Background="Transparent" BorderThickness="0" CornerRadius="16" Padding="10,6" AutomationProperties.Name="模型和思考设置" AutomationProperties.AutomationId="ChatModelSettings"><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="ModelLabel" Text="选择模型" VerticalAlignment="Center"/><FontIcon Glyph="&#xE70D;" FontSize="10"/></StackPanel></Button>
      <Button x:Name="SendButton" Grid.Column="3" Click="SendClicked" Width="36" Height="36" CornerRadius="18" Padding="0" Background="{ThemeResource TextFillColorPrimaryBrush}" Foreground="{ThemeResource LayerFillColorDefaultBrush}" AutomationProperties.Name="发送消息" AutomationProperties.AutomationId="SendChatMessage"><FontIcon Glyph="&#xE74A;" FontSize="18"/></Button>
     </Grid>
    </Grid>
   </Border>
  </Grid>
 </Border>
</UserControl>
