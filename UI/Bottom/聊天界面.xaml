<UserControl x:Class="Tomography.UI.Bottom.AiChatPanelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="ChatEffortAccentBrush" Color="#FFBE92"/></ResourceDictionary>
    <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="ChatEffortAccentBrush" Color="#984C25"/></ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="ChatEffortAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/></ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Style x:Key="ChatBubbleStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/></Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Border Style="{StaticResource WorkspaceCardStyle}" CornerRadius="24">
  <Grid RowSpacing="16" Margin="8,16,8,0">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="ConversationTitle" Text="新对话" FontSize="20" FontWeight="SemiBold"/>
   <Grid Grid.Row="1">
    <ListView x:Name="Messages" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Hidden" AutomationProperties.AutomationId="ChatMessages"/>
    <TextBlock x:Name="EmptyMessage" Text="开始新的对话" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Grid>
   <TextBlock x:Name="ChatStatus" Grid.Row="2" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="ChatStatus"/>
   <Border Grid.Row="3" Background="{ThemeResource ControlFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="28" Padding="10,8">
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Click="NewConversationClicked" Width="32" Height="32" CornerRadius="16" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Bottom" AutomationProperties.Name="新建对话" AutomationProperties.AutomationId="ComposerNewChat"><FontIcon Glyph="&#xE710;" FontSize="18"/></Button>
     <TextBox x:Name="MessageInput" Grid.Column="1" PlaceholderText="询问 AI" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="32" MaxHeight="160" Background="Transparent" BorderThickness="0" CornerRadius="16" VerticalAlignment="Center" TextChanged="MessageInputChanged" KeyDown="MessageInputKeyDown" AutomationProperties.Name="聊天消息" AutomationProperties.AutomationId="ChatInput"/>
     <Button Grid.Column="2" x:Name="ModelButton" Background="Transparent" BorderThickness="0" CornerRadius="16" Padding="10,6" VerticalAlignment="Bottom" AutomationProperties.Name="模型和思考设置" AutomationProperties.AutomationId="ChatModelSettings">
      <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock x:Name="ModelLabel" Text="选择强度" VerticalAlignment="Center"/><FontIcon Glyph="&#xE70D;" FontSize="10"/></StackPanel>
      <Button.Flyout>
       <Flyout x:Name="ModeFlyout" Opened="ModeFlyoutOpened" Placement="Top">
        <Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter"><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="16"/><Setter Property="Background" Value="{ThemeResource DevicePageBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource DeviceDividerBrush}"/><Setter Property="BorderThickness" Value="1"/></Style></Flyout.FlyoutPresenterStyle>
        <StackPanel Width="264" Spacing="10">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
          <FontIcon Glyph="&#xE945;" FontSize="18" VerticalAlignment="Top"/>
          <TextBlock x:Name="EffortHeading" Grid.Column="1" Text="中等" Foreground="{ThemeResource ChatEffortAccentBrush}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <Button Grid.Column="2" Click="ResetEffortClicked" Padding="6" Background="Transparent" BorderThickness="0" AutomationProperties.Name="恢复默认强度" AutomationProperties.AutomationId="ResetChatEffort"><FontIcon Glyph="&#xE777;" FontSize="16"/></Button>
         </Grid>
         <ComboBox x:Name="ModelChoice" HorizontalAlignment="Stretch" CornerRadius="12" SelectionChanged="ModelChoiceChanged" AutomationProperties.Name="选择模型" AutomationProperties.AutomationId="ComposerModel"/>
         <Slider x:Name="EffortSlider" Minimum="0" Maximum="4" StepFrequency="1" SnapsTo="StepValues" TickFrequency="1" ValueChanged="EffortValueChanged" AutomationProperties.Name="思考强度" AutomationProperties.AutomationId="ChatEffort">
          <Slider.Resources>
           <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
             <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="SliderTrackValueFill" Color="#FFBE92"/><SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFBE92"/><SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FFBE92"/></ResourceDictionary>
             <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="SliderTrackValueFill" Color="#984C25"/><SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#984C25"/><SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#984C25"/></ResourceDictionary>
             <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/><SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{ThemeResource SystemColorHighlightColor}"/></ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="SliderTrackThemeHeight">28</x:Double><x:Double x:Key="SliderHorizontalHeight">36</x:Double>
            <CornerRadius x:Key="SliderTrackCornerRadius">14</CornerRadius><CornerRadius x:Key="SliderThumbCornerRadius">18</CornerRadius>
            <x:Double x:Key="SliderHorizontalThumbWidth">34</x:Double><x:Double x:Key="SliderHorizontalThumbHeight">34</x:Double>
           </ResourceDictionary>
          </Slider.Resources>
         </Slider>
         <Button Content="更多设置" Click="OpenSettingsClicked" HorizontalAlignment="Center" Background="Transparent" BorderThickness="0" CornerRadius="12" AutomationProperties.AutomationId="ComposerMoreSettings"/>
        </StackPanel>
       </Flyout>
      </Button.Flyout>
     </Button>
     <Button x:Name="SendButton" Grid.Column="3" Click="SendClicked" Width="36" Height="36" CornerRadius="18" Padding="0" VerticalAlignment="Bottom" Background="{ThemeResource TextFillColorPrimaryBrush}" Foreground="{ThemeResource LayerFillColorDefaultBrush}" AutomationProperties.Name="发送消息" AutomationProperties.AutomationId="SendChatMessage"><FontIcon Glyph="&#xE74A;" FontSize="18"/></Button>
    </Grid>
   </Border>
  </Grid>
 </Border>
</UserControl>
