<UserControl x:Class="Tomography.UI.Controls.CommandPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource WorkspaceCardStyle}">
        <Grid RowSpacing="6">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="原始数据 / 指令" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ToggleButton Content="Rx" IsChecked="True" /><ToggleButton Content="Tx" IsChecked="True" />
                <ComboBox SelectedIndex="0" AutomationProperties.Name="数据编码"><x:String>UTF-8</x:String><x:String>GBK</x:String><x:String>ASCII</x:String></ComboBox>
                <TextBlock Text="接收 0 / 发送 0" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <TextBox Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="原始接收数据" AutomationProperties.Name="原始数据" />
            <Grid Grid.Row="2" ColumnSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ToggleButton Content="Hex" />
                <TextBox Grid.Column="1" PlaceholderText="输入自定义指令或发送数据" AutomationProperties.Name="发送内容" />
                <ComboBox Grid.Column="2" SelectedIndex="0" AutomationProperties.Name="发送追加内容"><x:String>无追加</x:String><x:String>CR</x:String><x:String>LF</x:String><x:String>CRLF</x:String></ComboBox>
                <Button Grid.Column="3" Content="发送" IsEnabled="False" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
