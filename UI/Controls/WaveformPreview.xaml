<UserControl x:Class="Tomography.UI.Controls.WaveformPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ColumnSpacing="8" RowSpacing="4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Grid.ColumnSpan="2" Text="原始通道值" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Grid Grid.Row="1">
            <TextBlock x:Name="MaximumLabel" Text="—" VerticalAlignment="Top" HorizontalAlignment="Right" />
            <TextBlock x:Name="MiddleLabel" Text="—" VerticalAlignment="Center" HorizontalAlignment="Right" />
            <TextBlock x:Name="MinimumLabel" Text="—" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
        </Grid>
        <Grid x:Name="PlotArea" Grid.Row="1" Grid.Column="1" SizeChanged="PlotSizeChanged" MinHeight="80" MinWidth="80">
            <Border BorderBrush="{ThemeResource WorkspaceStrokeBrush}" BorderThickness="1" />
            <Border VerticalAlignment="Center" Height="1" Background="{ThemeResource WorkspaceStrokeBrush}" />
            <Canvas>
                <Polyline x:Name="ChannelLine" Stroke="{ThemeResource SystemControlHighlightAccentBrush}" StrokeThickness="2"
                    AutomationProperties.Name="64 通道采样波形" />
            </Canvas>
            <TextBlock x:Name="EmptyMessage" Text="尚无采样数据" HorizontalAlignment="Center" VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
        <Grid Grid.Row="2" Grid.Column="1">
            <TextBlock Text="1" HorizontalAlignment="Left" /><TextBlock Text="32" HorizontalAlignment="Center" /><TextBlock Text="64" HorizontalAlignment="Right" />
        </Grid>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="通道" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</UserControl>
