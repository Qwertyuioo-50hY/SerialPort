<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Tomography.UI.Controls" xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Dark">
   <SolidColorBrush x:Key="TextControlBackground" Color="#29292C"/>
   <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#303034"/>
   <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#303034"/>
   <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#29292C"/>
   <SolidColorBrush x:Key="ComboBoxPopupBackgroundThemeBrush" Color="#29292C"/>
   <SolidColorBrush x:Key="ComboBoxBackground" Color="#29292C"/>
   <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#303034"/>
   <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#343438"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="TextControlBackground" Color="#F1F1F4"/>
   <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#E9E9EE"/>
   <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#E9E9EE"/>
   <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#F1F1F4"/>
   <SolidColorBrush x:Key="ComboBoxPopupBackgroundThemeBrush" Color="#F1F1F4"/>
   <SolidColorBrush x:Key="ComboBoxBackground" Color="#F1F1F4"/>
   <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#E9E9EE"/>
   <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#E2E2E8"/>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <CornerRadius x:Key="OverlayCornerRadius">18</CornerRadius>
 <CornerRadius x:Key="ComboBoxItemCornerRadius">10</CornerRadius>
 <Thickness x:Key="ComboBoxPopupBorderThemeThickness">0</Thickness>
 <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
 <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
 <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
 <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
 <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
 <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent"/>
 <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent"/>
 <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent"/>
 <CornerRadius x:Key="ControlCornerRadius">14</CornerRadius>
 <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text</FontFamily>
 <Style TargetType="TextBox"><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontFamily" Value="Segoe UI Variable Text"/></Style>
 <Style TargetType="PasswordBox"><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontFamily" Value="Segoe UI Variable Text"/></Style>
 <Style TargetType="NumberBox"><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontFamily" Value="Segoe UI Variable Text"/></Style>
 <Style x:Key="RoundedSearchEditor" TargetType="TextBox" BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}"><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,10"/></Style>
 <Style TargetType="AutoSuggestBox"><Setter Property="TextBoxStyle" Value="{StaticResource RoundedSearchEditor}"/><Setter Property="primitives:AutoSuggestBoxHelper.KeepInteriorCornersSquare" Value="False"/><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontFamily" Value="Segoe UI Variable Text"/></Style>
 <Style x:Key="RoundedComboStyle" TargetType="ComboBox"><Setter Property="primitives:ComboBoxHelper.KeepInteriorCornersSquare" Value="False"/><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,10"/><Setter Property="FontFamily" Value="Segoe UI Variable Text"/></Style>
 <Style TargetType="ComboBox" BasedOn="{StaticResource RoundedComboStyle}"/>
 <Style TargetType="controls:ClickComboBox" BasedOn="{StaticResource RoundedComboStyle}"/>
</ResourceDictionary>
