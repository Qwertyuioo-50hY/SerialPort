<Window x:Class="Tomography.UI.Account.LoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:Tomography.UI.Account" Title="FieldSync">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="#000000" Loaded="RootLoaded" SizeChanged="RootSizeChanged">
  <Grid.Resources>
   <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
     <SolidColorBrush x:Key="LoginBackground" Color="#000000"/>
     <SolidColorBrush x:Key="TextControlBackground" Color="#171719"/>
     <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#202023"/>
     <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1C1C1F"/>
     <SolidColorBrush x:Key="LoginLink" Color="#9BCBFF"/>
     <SolidColorBrush x:Key="LoginError" Color="#FF9F95"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="LoginBackground" Color="#FFFFFF"/>
     <SolidColorBrush x:Key="TextControlBackground" Color="#F2F2F5"/>
     <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#EAEAEE"/>
     <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#EEEEF2"/>
     <SolidColorBrush x:Key="LoginLink" Color="#0066CC"/>
     <SolidColorBrush x:Key="LoginError" Color="#B42318"/>
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent"/>
   <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
   <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent"/>
   <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
   <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
   <CornerRadius x:Key="ControlCornerRadius">14</CornerRadius>
   <Style TargetType="TextBox"><Setter Property="FontFamily" Value="Segoe UI Variable Text"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="44,16,16,16"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="14"/></Style>
   <Style TargetType="PasswordBox"><Setter Property="FontFamily" Value="Segoe UI Variable Text"/><Setter Property="FontSize" Value="15"/><Setter Property="Padding" Value="44,16,52,16"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="14"/></Style>
     </ResourceDictionary>
  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid x:Name="BrandPanel" Background="{ThemeResource LoginBackground}">
   <Image Source="ms-appx:///Assets/LoginArtwork.png" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/>
  </Grid>
  <ScrollViewer Grid.Column="1" Margin="40,76,40,32" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
   <ContentControl HorizontalContentAlignment="Stretch" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
    <StackPanel Spacing="22" MaxWidth="340" HorizontalAlignment="Stretch">
     <StackPanel Spacing="12" Margin="0,0,0,10">
      <TextBlock Text="{x:Bind ViewModel.FormTitle, Mode=OneWay}" FontFamily="Segoe UI Variable Display" FontSize="32" FontWeight="SemiBold"/>
     </StackPanel>
     <StackPanel Spacing="12">
      <Grid><TextBox PlaceholderText="{x:Bind ViewModel.UsernameText, Mode=OneWay}" MaxLength="64" Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Bind ViewModel.UsernameText, Mode=OneWay}" AutomationProperties.AutomationId="LoginUsername"/><FontIcon Glyph="&#xE77B;" FontSize="16" Margin="16,0,0,0" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/></Grid>
      <Grid><PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordChanged" PasswordRevealMode="Hidden" PlaceholderText="{x:Bind ViewModel.PasswordText, Mode=OneWay}" MaxLength="128" Password="{x:Bind ViewModel.Password, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.PasswordText, Mode=OneWay}" AutomationProperties.AutomationId="LoginPassword"/><FontIcon Glyph="&#xE72E;" FontSize="16" Margin="16,0,0,0" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False"/>
       <Button x:Name="PasswordEye" Click="PasswordEyeClicked" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Width="36" Height="36" Padding="0" CornerRadius="10" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind ViewModel.ShowPasswordText, Mode=OneWay}" AutomationProperties.AutomationId="PasswordEye"><FontIcon x:Name="PasswordEyeIcon" Glyph="&#xE890;" FontSize="17"/></Button>
      </Grid>
      <Grid Visibility="{x:Bind local:LoginWindow.ToVisibility(ViewModel.IsRegistering), Mode=OneWay}"><PasswordBox x:Name="ConfirmationInput" PasswordChanged="PasswordChanged" PasswordRevealMode="Hidden" PlaceholderText="{x:Bind ViewModel.ConfirmationText, Mode=OneWay}" MaxLength="128" Password="{x:Bind ViewModel.Confirmation, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.ConfirmationText, Mode=OneWay}" AutomationProperties.AutomationId="RegisterConfirmation"/><FontIcon x:Name="ConfirmationStatusIcon" Glyph="&#xE72E;" FontSize="16" Margin="16,0,0,0" HorizontalAlignment="Left" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" AutomationProperties.AutomationId="ConfirmationStatus"/>
       <Button x:Name="ConfirmationEye" Click="ConfirmationEyeClicked" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Width="36" Height="36" Padding="0" CornerRadius="10" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind ViewModel.ShowPasswordText, Mode=OneWay}" AutomationProperties.AutomationId="ConfirmationEye"><FontIcon x:Name="ConfirmationEyeIcon" Glyph="&#xE890;" FontSize="17"/></Button>
      </Grid>
     </StackPanel>
     <TextBlock Text="{x:Bind ViewModel.PasswordHint, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind local:LoginWindow.ToVisibility(ViewModel.IsRegistering), Mode=OneWay}"/>
     <Grid Visibility="{x:Bind local:LoginWindow.ToVisibility(ViewModel.IsLogin), Mode=OneWay}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <CheckBox Content="{x:Bind ViewModel.RememberText, Mode=OneWay}" FontSize="13" IsChecked="{x:Bind ViewModel.RememberAccount, Mode=TwoWay}" AutomationProperties.AutomationId="RememberAccount"/>
      <CheckBox Grid.Column="1" Content="{x:Bind ViewModel.AutoLoginText, Mode=OneWay}" FontSize="13" IsChecked="{x:Bind ViewModel.AutoLogin, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind ViewModel.AutoLoginHint, Mode=OneWay}" AutomationProperties.AutomationId="AutoLogin"/>
     </Grid>
     <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource LoginError}" TextWrapping="Wrap" Visibility="{x:Bind local:LoginWindow.MessageVisibility(ViewModel.Message), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="LoginMessage"/>
     <Button Command="{x:Bind ViewModel.SubmitCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="16,15" Background="#0A84FF" Foreground="White" BorderThickness="0" CornerRadius="14" AutomationProperties.Name="{x:Bind ViewModel.SubmitText, Mode=OneWay}" AutomationProperties.AutomationId="LoginSubmit"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{x:Bind ViewModel.SubmitText, Mode=OneWay}" FontWeight="SemiBold"/><FontIcon Glyph="&#xE72A;" FontSize="14"/></StackPanel></Button>
     <Button Content="{x:Bind ViewModel.SwitchText, Mode=OneWay}" Command="{x:Bind ViewModel.SwitchModeCommand}" HorizontalAlignment="Center" FontSize="13" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource LoginLink}" CornerRadius="12" AutomationProperties.AutomationId="LoginSwitchMode"/>
    </StackPanel>
   </ContentControl>
  </ScrollViewer>
  <ProgressRing Grid.Column="1" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"/>
  <Grid x:Name="DragRegion" Grid.ColumnSpan="2" Height="48" Margin="0,0,192,0" VerticalAlignment="Top" Background="Transparent"/>
  <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="8">
   <Button Width="40" Height="36" Background="Transparent" BorderThickness="0" CornerRadius="12" AutomationProperties.Name="{x:Bind ViewModel.ThemeText, Mode=OneWay}" AutomationProperties.AutomationId="LoginTheme"><FontIcon Glyph="&#xE790;" FontSize="17"/><Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight"><RadioMenuFlyoutItem x:Name="DarkTheme" Text="{x:Bind ViewModel.DarkText, Mode=OneWay}" GroupName="LoginTheme" Click="DarkClicked" AutomationProperties.AutomationId="LoginDark"/><RadioMenuFlyoutItem x:Name="LightTheme" Text="{x:Bind ViewModel.LightText, Mode=OneWay}" GroupName="LoginTheme" Click="LightClicked" AutomationProperties.AutomationId="LoginLight"/></MenuFlyout></Button.Flyout></Button>
   <Button x:Name="LanguageButton" Width="40" Height="36" Background="Transparent" BorderThickness="0" CornerRadius="12" AutomationProperties.Name="{x:Bind ViewModel.LanguageText, Mode=OneWay}" AutomationProperties.AutomationId="LoginLanguage"><FontIcon Glyph="&#xE774;" FontSize="17"/><Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight"><RadioMenuFlyoutItem x:Name="ChineseLanguage" Text="简体中文" GroupName="LoginLanguage" Click="ChineseClicked" AutomationProperties.AutomationId="LoginChinese"/><RadioMenuFlyoutItem x:Name="EnglishLanguage" Text="English" GroupName="LoginLanguage" Click="EnglishClicked" AutomationProperties.AutomationId="LoginEnglish"/></MenuFlyout></Button.Flyout></Button>
   <Button Content="&#xE921;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Width="40" Height="36" Background="Transparent" BorderThickness="0" CornerRadius="12" Click="MinimizeClicked" AutomationProperties.Name="{x:Bind ViewModel.MinimizeText, Mode=OneWay}"/>
   <Button Content="&#xE8BB;" FontFamily="{ThemeResource SymbolThemeFontFamily}" Width="40" Height="36" Background="Transparent" BorderThickness="0" CornerRadius="12" Click="CloseClicked" AutomationProperties.Name="{x:Bind ViewModel.CloseText, Mode=OneWay}"/>
  </StackPanel>
 </Grid>
</Window>
