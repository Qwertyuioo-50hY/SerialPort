<UserControl x:Class="Tomography.UI.workspace.ChannelWaveformView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI" xmlns:controls="using:Tomography.UI.Controls">
 <Grid RowSpacing="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal" Spacing="8">
   <controls:ClickComboBox x:Name="WaveformSelection" SelectedIndex="0" SelectionChanged="WaveformSelectionChanged" MinWidth="108" CornerRadius="10" AutomationProperties.Name="显示波形"><x:String>共同显示</x:String><x:String>空场波形</x:String><x:String>物场波形</x:String></controls:ClickComboBox>
   <Button Content="＋" Click="ZoomInClicked" ToolTipService.ToolTip="纵轴放大" AutomationProperties.Name="纵轴放大" Padding="10,6"/>
   <Button Content="−" Click="ZoomOutClicked" ToolTipService.ToolTip="纵轴缩小" AutomationProperties.Name="纵轴缩小" Padding="10,6"/>
   <Button Content="自适应" Click="ResetZoomClicked" Padding="10,6"/>
  </StackPanel>
  <Grid Grid.Row="1" Background="Black">
   <lvc:CartesianChart x:Name="Chart" LegendPosition="Top"/>
   <TextBlock Text="幅值 (V)" FontSize="11" Margin="8,6,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="White" IsHitTestVisible="False"/>
   <TextBlock Text="通道" FontSize="11" Margin="0,0,4,12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="White" IsHitTestVisible="False"/>
  </Grid>
 </Grid>
</UserControl>
