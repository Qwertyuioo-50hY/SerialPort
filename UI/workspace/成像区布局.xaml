<UserControl x:Class="Tomography.UI.workspace.ImagingWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Tomography.UI.workspace">
 <Border Style="{StaticResource WorkspaceCardStyle}">
  <StackPanel Spacing="20">
   <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,24,0,0"><FontIcon Glyph="&#xE9D9;" FontSize="22" Foreground="{ThemeResource RailAccentBrush}"/><TextBlock Text="数据分析" FontSize="24" FontWeight="SemiBold"/></StackPanel>
   <Border x:Name="WaveformModule" Style="{StaticResource WorkspaceCardStyle}" BorderThickness="1" Padding="16" CornerRadius="8">
    <Grid ColumnSpacing="20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ContentControl x:Name="CommandHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     <Grid Grid.Column="1" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="340"/></Grid.RowDefinitions>
      <TextBlock Text="空场与物场波形" FontSize="16" FontWeight="SemiBold"/><local:ChannelWaveformView x:Name="ChannelWaveform" Grid.Row="1"/>
     </Grid>
    </Grid>
   </Border>
   <Grid ColumnSpacing="16" RowSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="DataModule" Style="{StaticResource WorkspaceCardStyle}" BorderThickness="1" Padding="16" CornerRadius="8">
     <local:ChannelDataView x:Name="ChannelTable"/>
    </Border>
    <Border x:Name="ReconstructionModule" Grid.Column="1" Style="{StaticResource WorkspaceCardStyle}" BorderThickness="1" Padding="16" CornerRadius="8">
     <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid><Button Content="重建" Click="ReconstructionClicked" HorizontalAlignment="Right" AutomationProperties.AutomationId="ReconstructImage"/></Grid>
      <local:ReconstructionImageView x:Name="ReconstructionImage" Grid.Row="1" MinHeight="360"/>
     </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource WorkspaceCardStyle}" BorderThickness="1" Padding="16" CornerRadius="8">
     <StackPanel Spacing="12"><TextBlock Text="算法配置" FontSize="16" FontWeight="SemiBold"/><StackPanel x:Name="AlgorithmBody" Spacing="12"/></StackPanel>
    </Border>
    <Border x:Name="CameraModule" Grid.Row="1" Grid.Column="1" Style="{StaticResource WorkspaceCardStyle}" BorderThickness="1" Padding="16" CornerRadius="8">
     <StackPanel Spacing="12"><TextBlock Text="相机模块" FontSize="16" FontWeight="SemiBold"/><local:CameraPreviewView MinHeight="320"/></StackPanel>
    </Border>
   </Grid>
  </StackPanel>
 </Border>
</UserControl>
