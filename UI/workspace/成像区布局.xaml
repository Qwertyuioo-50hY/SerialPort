<UserControl x:Class="Tomography.UI.workspace.ImagingWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Tomography.UI.workspace" xmlns:side="using:Tomography.UI.SideView">
 <UserControl.Resources>
  <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>
  <Style TargetType="Button">
   <Setter Property="CornerRadius" Value="10"/>
   <Setter Property="MinHeight" Value="36"/>
   <Setter Property="HorizontalAlignment" Value="Stretch"/>
   <Setter Property="Padding" Value="16,8"/>
   <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
   <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
  </Style>
  <Style TargetType="NumberBox"><Setter Property="CornerRadius" Value="10"/></Style>
  <Style TargetType="ComboBox"><Setter Property="CornerRadius" Value="10"/></Style>
  <Style TargetType="TextBox"><Setter Property="CornerRadius" Value="10"/></Style>
 </UserControl.Resources>
 <Border Style="{StaticResource WorkspaceCardStyle}">
  <StackPanel Spacing="20">
   <Border x:Name="WaveformModule" Style="{StaticResource WorkspaceCardStyle}" BorderThickness="1" Padding="16" CornerRadius="16">
    <Grid ColumnSpacing="20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ContentControl x:Name="CommandHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
     <local:ChannelWaveformView x:Name="ChannelWaveform" Grid.Column="1" Height="340"/>
    </Grid>
   </Border>
   <Grid ColumnSpacing="16" RowSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="DataModule" Style="{StaticResource WorkspaceCardStyle}" BorderThickness="1" Padding="16" CornerRadius="16">
     <local:ChannelDataView x:Name="ChannelTable"/>
    </Border>
    <Border x:Name="ReconstructionModule" Grid.Column="1" Style="{StaticResource WorkspaceCardStyle}" BorderThickness="1" Padding="16" CornerRadius="16">
     <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
       <TextBlock Text="帧率 (FPS)" VerticalAlignment="Center"/>
       <NumberBox x:Name="ReconstructionFps" Value="5" Minimum="1" Maximum="60" Width="100" SpinButtonPlacementMode="Compact" ValueChanged="ReconstructionFpsChanged" AutomationProperties.Name="实时重建帧率"/>
       <Button Content="重建" Click="ReconstructionClicked" AutomationProperties.AutomationId="ReconstructImage"/>
      </StackPanel>
      <local:ReconstructionImageView x:Name="ReconstructionImage" Grid.Row="1" MinHeight="360"/>
     </Grid>
    </Border>
    <Border Grid.Row="1" Style="{StaticResource WorkspaceCardStyle}" BorderThickness="1" Padding="16" CornerRadius="16">
     <side:ReceivedDataView x:Name="ReceivedData"/>
    </Border>
    <Border x:Name="CameraModule" Grid.Row="1" Grid.Column="1" Style="{StaticResource WorkspaceCardStyle}" BorderThickness="1" Padding="16" CornerRadius="16">
     <StackPanel Spacing="12"><TextBlock Text="相机模块" FontSize="16" FontWeight="SemiBold"/><local:CameraPreviewView MinHeight="320"/></StackPanel>
    </Border>
   </Grid>
  </StackPanel>
 </Border>
</UserControl>
