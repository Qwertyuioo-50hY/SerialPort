<UserControl x:Class="Tomography.UI.Navigation.ImportedFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource WorkspaceCardStyle}">
        <Grid RowSpacing="20">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                <Button Content="&#xE921;" Tag="Minimize" Click="WindowCommandClicked" FontFamily="{ThemeResource SymbolThemeFontFamily}" Background="Transparent" BorderThickness="0" Padding="8" AutomationProperties.Name="最小化" />
                <Button Content="&#xE922;" Tag="Maximize" Click="WindowCommandClicked" FontFamily="{ThemeResource SymbolThemeFontFamily}" Background="Transparent" BorderThickness="0" Padding="8" AutomationProperties.Name="最大化或还原" />
                <Button Content="&#xE8BB;" Tag="Close" Click="WindowCommandClicked" FontFamily="{ThemeResource SymbolThemeFontFamily}" Background="Transparent" BorderThickness="0" Padding="8" AutomationProperties.Name="关闭窗口" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource RailAccentBrush}" />
                <TextBlock Text="项目导航" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
            <TextBox Grid.Row="2" PlaceholderText="搜索项目文件…" CornerRadius="10" AutomationProperties.Name="搜索项目文件" />
            <ListView x:Name="Files" Grid.Row="3" AutomationProperties.Name="已导入文件" AutomationProperties.AutomationId="ImportedFiles" />
            <StackPanel x:Name="EmptyMessage" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <FontIcon Glyph="&#xE8B7;" FontSize="32" Foreground="{ThemeResource RailForegroundBrush}" />
                <TextBlock Text="尚未导入文件" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
