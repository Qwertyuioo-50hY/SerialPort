<UserControl x:Class="Tomography.UI.SideView.AiSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Style="{StaticResource WorkspaceCardStyle}">
  <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Spacing="20" MaxWidth="640" HorizontalAlignment="Stretch" Margin="12,24">
    <TextBlock Text="设置" FontSize="24" FontWeight="SemiBold"/>
    <TextBox x:Name="BaseUrl" Header="API 地址（Base URL，Anthropic 可填主机根地址）" CornerRadius="12" AutomationProperties.AutomationId="AiBaseUrl"/>
    <TextBox x:Name="KeyEnvironment" Header="API Key 环境变量（未填写密钥时使用）" CornerRadius="12" AutomationProperties.AutomationId="AiKeyEnvironment"/>
    <PasswordBox x:Name="ApiKey" Header="API Key" CornerRadius="12" AutomationProperties.AutomationId="AiApiKey"/>
    <ComboBox x:Name="Model" Header="模型选择（可输入中转站模型名）" IsEditable="True" HorizontalAlignment="Stretch" CornerRadius="12" AutomationProperties.AutomationId="AiModel"/>
    <TextBox x:Name="Models" Header="可选模型（每行一个）" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" CornerRadius="12" AutomationProperties.AutomationId="AiModels"/>
    <TextBox x:Name="PythonDll" Header="Python 运行时 DLL" CornerRadius="12" AutomationProperties.AutomationId="AiPythonDll"/>
    <ComboBox x:Name="ApiMode" Header="接口协议" HorizontalAlignment="Stretch" CornerRadius="12" SelectedIndex="0" AutomationProperties.AutomationId="AiApiMode"><ComboBoxItem Content="Anthropic Messages（Claude）" Tag="anthropic_messages"/><ComboBoxItem Content="Responses" Tag="responses"/><ComboBoxItem Content="Chat Completions（中转兼容）" Tag="chat_completions"/></ComboBox>
    <ComboBox x:Name="ReasoningMode" Header="模型模式" HorizontalAlignment="Stretch" CornerRadius="12" SelectedIndex="0" AutomationProperties.AutomationId="AiReasoningMode"><ComboBoxItem Content="Standard" Tag="standard"/><ComboBoxItem Content="Pro" Tag="pro"/></ComboBox>
    <ComboBox x:Name="ReasoningEffort" Header="思考强度" HorizontalAlignment="Stretch" CornerRadius="12" SelectedIndex="0" AutomationProperties.AutomationId="AiReasoningEffort"><ComboBoxItem Content="模型默认" Tag="default"/><ComboBoxItem Content="轻度 (low)" Tag="low"/><ComboBoxItem Content="中等 (medium)" Tag="medium"/><ComboBoxItem Content="高 (high)" Tag="high"/><ComboBoxItem Content="极高 (xhigh)" Tag="xhigh"/><ComboBoxItem Content="最高 (max)" Tag="max"/></ComboBox>
    <ComboBox x:Name="ServiceTier" Header="模型速度" HorizontalAlignment="Stretch" CornerRadius="12" SelectedIndex="0" AutomationProperties.AutomationId="AiServiceTier"><ComboBoxItem Content="标准 (default)" Tag="default"/><ComboBoxItem Content="快速 (Fast)" Tag="priority"/><ComboBoxItem Content="极速 (Ultrafast)" Tag="ultrafast"/><ComboBoxItem Content="自动 (auto)" Tag="auto"/></ComboBox>
    <ComboBox x:Name="Verbosity" Header="输出详细程度" HorizontalAlignment="Stretch" CornerRadius="12" SelectedIndex="0" AutomationProperties.AutomationId="AiVerbosity"><ComboBoxItem Content="模型默认" Tag="default"/><ComboBoxItem Content="简洁 (low)" Tag="low"/><ComboBoxItem Content="适中 (medium)" Tag="medium"/><ComboBoxItem Content="详细 (high)" Tag="high"/></ComboBox>
    <ComboBox x:Name="OutputFormat" Header="输出格式" HorizontalAlignment="Stretch" CornerRadius="12" SelectedIndex="0" AutomationProperties.AutomationId="AiOutputFormat"><ComboBoxItem Content="文本" Tag="text"/><ComboBoxItem Content="Markdown" Tag="markdown"/><ComboBoxItem Content="JSON 对象" Tag="json_object"/></ComboBox>
    <ComboBox x:Name="Tone" Header="语气" IsEditable="True" HorizontalAlignment="Stretch" CornerRadius="12" AutomationProperties.AutomationId="AiTone"><x:String>默认</x:String><x:String>专业</x:String><x:String>友好</x:String><x:String>直接简洁</x:String></ComboBox>
    <ComboBox x:Name="ResponseLanguage" Header="输出语言" IsEditable="True" HorizontalAlignment="Stretch" CornerRadius="12" AutomationProperties.AutomationId="AiLanguage"><x:String>跟随用户</x:String><x:String>中文</x:String><x:String>English</x:String></ComboBox>
    <TextBox x:Name="Instructions" Header="自定义指令" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" CornerRadius="12" AutomationProperties.AutomationId="AiInstructions"/>
    <TextBox x:Name="OutputInstructions" Header="输出内容要求" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" CornerRadius="12" AutomationProperties.AutomationId="AiOutputInstructions"/>
    <NumberBox x:Name="MaxOutputTokens" Header="输出 Token 上限（0 为模型默认）" Minimum="0" Maximum="2147483647" SpinButtonPlacementMode="Hidden" CornerRadius="12" AutomationProperties.AutomationId="AiMaxOutputTokens"/>
    <NumberBox x:Name="TimeoutSeconds" Header="请求超时（秒）" Minimum="1" Maximum="3600" SpinButtonPlacementMode="Hidden" CornerRadius="12" AutomationProperties.AutomationId="AiTimeoutSeconds"/>
    <Button Content="保存" Click="SaveClicked" CornerRadius="12" AutomationProperties.AutomationId="SaveAiSettings"/>
    <TextBlock x:Name="SaveStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="AiSettingsStatus"/>
   </StackPanel>
  </ScrollViewer>
 </Border>
</UserControl>
