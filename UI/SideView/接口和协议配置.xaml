<UserControl x:Class="Tomography.UI.SideView.ConnectionProtocolView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Tomography.UI.Controls">
 <Grid RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Spacing="24">
   <RadioButtons x:Name="ConnectionType" Header="数据接口" MaxColumns="1" SelectedIndex="0" SelectionChanged="ConfigurationChanged" AutomationProperties.AutomationId="ConnectionType"><x:String>串口</x:String><x:String>UDP</x:String><x:String>TCP客户端</x:String><x:String>TCP服务端</x:String></RadioButtons>
   <RadioButtons x:Name="DataProtocol" Header="数据协议" MaxColumns="1" SelectedIndex="0" SelectionChanged="ConfigurationChanged" AutomationProperties.AutomationId="DataProtocol"><x:String>默认</x:String><x:String>EMT协议</x:String><x:String>自定义协议</x:String></RadioButtons>
  </StackPanel>
  <ContentControl x:Name="TransportHost" Grid.Row="1" HorizontalContentAlignment="Stretch">
   <StackPanel Spacing="16">
  <StackPanel x:Name="SerialParameters" Spacing="16" HorizontalAlignment="Stretch">
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="端口" VerticalAlignment="Center"/><controls:ClickComboBox x:Name="DevicePortField" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ConfigurationChanged" AutomationProperties.AutomationId="DevicePortField" AutomationProperties.Name="端口"><x:String>选择端口</x:String></controls:ClickComboBox><Button Grid.Column="2" Click="RefreshClicked" AutomationProperties.Name="刷新串口" AutomationProperties.AutomationId="RefreshPorts" ToolTipService.ToolTip="刷新串口"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button></Grid>
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="波特率" VerticalAlignment="Center"/><controls:ClickComboBox x:Name="BaudRateField" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ConfigurationChanged" AutomationProperties.AutomationId="BaudRateField" AutomationProperties.Name="波特率"><x:String>115200</x:String><x:String>57600</x:String><x:String>38400</x:String><x:String>19200</x:String><x:String>9600</x:String></controls:ClickComboBox></Grid>
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="数据位" VerticalAlignment="Center"/><controls:ClickComboBox x:Name="DataBitsField" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ConfigurationChanged" AutomationProperties.AutomationId="DataBitsField" AutomationProperties.Name="数据位"><x:String>8</x:String><x:String>7</x:String><x:String>6</x:String><x:String>5</x:String></controls:ClickComboBox></Grid>
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="校验位" VerticalAlignment="Center"/><controls:ClickComboBox x:Name="ParityField" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ConfigurationChanged" AutomationProperties.AutomationId="ParityField" AutomationProperties.Name="校验位"><x:String>None</x:String><x:String>Odd</x:String><x:String>Even</x:String></controls:ClickComboBox></Grid>
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><TextBlock Text="停止位" VerticalAlignment="Center"/><controls:ClickComboBox x:Name="StopBitsField" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ConfigurationChanged" AutomationProperties.AutomationId="StopBitsField" AutomationProperties.Name="停止位"><x:String>1</x:String><x:String>2</x:String><x:String>1.5</x:String></controls:ClickComboBox></Grid>
    <StackPanel Spacing="12">
<controls:ClickComboBox x:Name="FlowControlField" Header="流控" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ConfigurationChanged" AutomationProperties.AutomationId="FlowControlField"><x:String>None</x:String><x:String>XOnXOff</x:String><x:String>RequestToSend</x:String><x:String>RequestToSendXOnXOff</x:String></controls:ClickComboBox>
<controls:ClickComboBox x:Name="EncodingField" Header="编码" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="ConfigurationChanged" AutomationProperties.AutomationId="EncodingField"><x:String>UTF-8</x:String><x:String>GBK</x:String><x:String>ASCII</x:String><x:String>Unicode</x:String></controls:ClickComboBox>
     <StackPanel Orientation="Horizontal" Spacing="20"><CheckBox x:Name="DTRField" Content="DTR" Checked="FlagChanged" Unchecked="FlagChanged" AutomationProperties.AutomationId="DTR"/><CheckBox x:Name="RTSField" Content="RTS" Checked="FlagChanged" Unchecked="FlagChanged" AutomationProperties.AutomationId="RTS"/></StackPanel>
    </StackPanel>
  </StackPanel>
  <StackPanel x:Name="TcpParameters" Spacing="12" HorizontalAlignment="Stretch" Visibility="Collapsed">
   <TextBox x:Name="TcpHost" Header="远端地址 / 监听地址" Text="127.0.0.1" TextChanged="TextChanged" AutomationProperties.AutomationId="TcpHost"/>
   <NumberBox x:Name="TcpPort" Header="端口" Value="1346" Minimum="1" Maximum="65535" ValueChanged="NumberChanged" AutomationProperties.AutomationId="TcpPort"/>
   <NumberBox x:Name="TcpTimeout" Header="超时 / 秒" Value="3" Minimum="1" Maximum="60" ValueChanged="NumberChanged" AutomationProperties.AutomationId="TcpTimeout"/>
   <StackPanel x:Name="UdpLocalParameters" Spacing="12" Visibility="Collapsed">
    <TextBox x:Name="LocalHostField" Header="本地地址" Text="0.0.0.0" TextChanged="TextChanged"/>
    <NumberBox x:Name="LocalPortField" Header="本地端口" Value="1347" Minimum="1" Maximum="65535" ValueChanged="NumberChanged"/>
   </StackPanel>
  </StackPanel>
   </StackPanel>
  </ContentControl>
 </Grid>
</UserControl>
