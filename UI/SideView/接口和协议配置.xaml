<UserControl x:Class="Tomography.UI.SideView.ConnectionProtocolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="10">
        <TextBlock Text="协议与连接" FontSize="14" FontWeight="SemiBold" />
        <Border Height="1" Background="{ThemeResource WorkspaceStrokeBrush}" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
            <TextBlock Text="数据源" VerticalAlignment="Center" />
            <ComboBox x:Name="DataSource" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" AutomationProperties.AutomationId="DataSource" AutomationProperties.Name="数据源" SelectionChanged="ConfigurationChanged">
<x:String>实际设备</x:String><x:String>Demo</x:String><x:String>文件回放</x:String><x:String>模拟数据</x:String></ComboBox>
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
            <TextBlock Text="数据接口" VerticalAlignment="Center" />
            <ComboBox x:Name="ConnectionType" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" AutomationProperties.AutomationId="ConnectionType" AutomationProperties.Name="数据接口" SelectionChanged="ConfigurationChanged">
<x:String>串口 UART/USB-TTL</x:String><x:String>TCP</x:String><x:String>UDP</x:String></ComboBox>
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
            <TextBlock Text="数据协议" VerticalAlignment="Center" />
            <ComboBox x:Name="DataProtocol" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" AutomationProperties.AutomationId="DataProtocol" AutomationProperties.Name="数据协议" SelectionChanged="ConfigurationChanged">
<x:String>FireWater/CSV</x:String><x:String>JSON</x:String><x:String>Modbus RTU</x:String></ComboBox>
        </Grid>
        <Border Height="1" Background="{ThemeResource WorkspaceStrokeBrush}" />
        <TextBlock x:Name="ParametersHeading" Text="串口参数配置" FontSize="14" FontWeight="SemiBold" />
        <StackPanel x:Name="SerialParameters" Spacing="10">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="端口号" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" x:Name="DevicePortField" AutomationProperties.AutomationId="DevicePort" AutomationProperties.Name="端口号">
                <x:String>选择端口</x:String>
            </ComboBox>
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="波特率" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" x:Name="BaudRateField" AutomationProperties.AutomationId="BaudRate" AutomationProperties.Name="波特率">
                <x:String>115200</x:String><x:String>57600</x:String><x:String>38400</x:String><x:String>19200</x:String><x:String>9600</x:String>
            </ComboBox>
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="数据流控" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" x:Name="FlowControlField" AutomationProperties.AutomationId="FlowControl" AutomationProperties.Name="数据流控">
                <x:String>None</x:String><x:String>XOnXOff</x:String><x:String>RequestToSend</x:String><x:String>RequestToSendXOnXOff</x:String>
            </ComboBox>
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="校验位" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" x:Name="ParityField" AutomationProperties.AutomationId="Parity" AutomationProperties.Name="校验位">
                <x:String>None</x:String><x:String>Odd</x:String><x:String>Even</x:String>
            </ComboBox>
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="数据位数" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" x:Name="DataBitsField" AutomationProperties.AutomationId="DataBits" AutomationProperties.Name="数据位数">
                <x:String>8</x:String><x:String>7</x:String><x:String>6</x:String><x:String>5</x:String>
            </ComboBox>
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="停止位数" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" x:Name="StopBitsField" AutomationProperties.AutomationId="StopBits" AutomationProperties.Name="停止位数">
                <x:String>1</x:String><x:String>2</x:String><x:String>1.5</x:String>
            </ComboBox>
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="编码" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" x:Name="EncodingField" AutomationProperties.AutomationId="Encoding" AutomationProperties.Name="编码">
                <x:String>UTF-8</x:String><x:String>GBK</x:String><x:String>ASCII</x:String><x:String>Unicode</x:String>
            </ComboBox>
        </Grid>
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="流控信号" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <CheckBox Content="DTR" MinWidth="0" x:Name="DTRField" AutomationProperties.AutomationId="DTR" />
                <CheckBox Content="RTS" MinWidth="0" x:Name="RTSField" AutomationProperties.AutomationId="RTS" />
                <CheckBox Content="Break" MinWidth="0" AutomationProperties.AutomationId="BreakSignal" />
            </StackPanel>
        </Grid>
        </StackPanel>
        <StackPanel x:Name="TcpParameters" Spacing="10" Visibility="Collapsed">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="服务器IP" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="127.0.0.1" AutomationProperties.AutomationId="TcpHost" AutomationProperties.Name="服务器IP" />
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="网络端口" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="1346" AutomationProperties.AutomationId="TcpPort" AutomationProperties.Name="网络端口" />
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="握手数据" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="plot0" AutomationProperties.AutomationId="TcpHandshake" AutomationProperties.Name="握手数据" />
        </Grid>
        </StackPanel>
        <StackPanel x:Name="UdpParameters" Spacing="10" Visibility="Collapsed">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="远程IP" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="127.0.0.1" AutomationProperties.AutomationId="UdpHost" AutomationProperties.Name="远程IP" />
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="远程端口" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="1346" AutomationProperties.AutomationId="UdpRemotePort" AutomationProperties.Name="远程端口" />
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="本地端口" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="1347" AutomationProperties.AutomationId="UdpLocalPort" AutomationProperties.Name="本地端口" />
        </Grid>
        </StackPanel>
        <StackPanel x:Name="DemoParameters" Spacing="10" Visibility="Collapsed">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
            <TextBlock Text="生成数据格式" VerticalAlignment="Center" />
            <ComboBox x:Name="DemoFormat" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" AutomationProperties.AutomationId="DemoFormat" AutomationProperties.Name="生成数据格式" SelectionChanged="ConfigurationChanged">
<x:String>FireWater/CSV</x:String><x:String>JSON</x:String><x:String>Modbus RTU</x:String></ComboBox>
        </Grid>
            <TextBlock Text="与数据协议一致，用于解析测试数据" FontSize="11" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Border Height="1" Background="{ThemeResource WorkspaceStrokeBrush}" />
            <Expander HorizontalAlignment="Stretch" IsExpanded="False">
                <Expander.Header><StackPanel Spacing="4"><CheckBox Content="默认数据源" IsChecked="True" /><TextBlock Text="由软件生成的默认数据" FontSize="11" MaxWidth="210" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Expander.Header>
                <StackPanel Spacing="8"></StackPanel>
            </Expander>
            <Expander HorizontalAlignment="Stretch" IsExpanded="False">
                <Expander.Header><StackPanel Spacing="4"><CheckBox Content="CSV数据源" IsChecked="False" /><TextBlock Text="按文件名称排序，周期发送指定目录中的 CSV 数据" FontSize="11" MaxWidth="210" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Expander.Header>
                <StackPanel Spacing="8">        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="CSV目录" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="" AutomationProperties.AutomationId="DemoCsvDirectory" AutomationProperties.Name="CSV目录" />
        </Grid>
</StackPanel>
            </Expander>
            <Expander HorizontalAlignment="Stretch" IsExpanded="False">
                <Expander.Header><StackPanel Spacing="4"><CheckBox Content="发送jpg图片" IsChecked="False" /><TextBlock Text="按文件名称排序，周期发送指定目录中的 jpg 图片" FontSize="11" MaxWidth="210" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel></Expander.Header>
                <StackPanel Spacing="8">        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="图片目录" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="" AutomationProperties.AutomationId="DemoImageDirectory" AutomationProperties.Name="图片目录" />
        </Grid>
</StackPanel>
            </Expander>
        </StackPanel>
        <StackPanel x:Name="ReplayParameters" Spacing="10" Visibility="Collapsed">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="回放文件" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="" AutomationProperties.AutomationId="ReplayFile" AutomationProperties.Name="回放文件" />
        </Grid>
        </StackPanel>
        <StackPanel x:Name="SimulationParameters" Spacing="10" Visibility="Collapsed">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="通道数" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="64" AutomationProperties.AutomationId="SimulationChannels" AutomationProperties.Name="通道数" />
        </Grid>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions>
            <TextBlock Text="采样频率 / Hz" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="5" AutomationProperties.AutomationId="SimulationFrequency" AutomationProperties.Name="采样频率 / Hz" />
        </Grid>
        </StackPanel>
        <Border Height="1" Background="{ThemeResource WorkspaceStrokeBrush}" />
    </StackPanel>
</UserControl>
