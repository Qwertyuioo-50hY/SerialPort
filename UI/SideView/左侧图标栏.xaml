<UserControl x:Class="Tomography.UI.SideView.IconRailView" x:Name="RailRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource RailForegroundBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid Padding="0,12,0,8" CornerRadius="{Binding CornerRadius, ElementName=RailRoot}" Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Spacing="10">
            <Border Width="38" Height="38" CornerRadius="11" Background="{ThemeResource LogoPlateBrush}" Padding="5" HorizontalAlignment="Center">
                <Image Source="ms-appx:///Assets/BrandLogo.png" AutomationProperties.Name="软件 Logo" />
            </Border>
            <Button Style="{StaticResource RailButtonStyle}" Click="CollapseDirectory" AutomationProperties.AutomationId="CollapseDirectory" AutomationProperties.Name="折叠资源栏" ToolTipService.ToolTip="折叠资源栏"><Path Width="18" Height="15" Stretch="Uniform" Stroke="{ThemeResource RailForegroundBrush}" StrokeThickness="2" Data="M 0,3 L 13,3 M 0,10 L 13,10 M 0,17 L 13,17 M 16,3 L 23,10 L 16,17" /></Button>
            <Border Height="1" Background="{ThemeResource WorkspaceStrokeBrush}" />
            <Grid Height="64">
                <Border Width="40" Height="40" CornerRadius="12" Background="{ThemeResource RailSelectedBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="G" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Width="15" Height="15" CornerRadius="8" Background="{ThemeResource RailAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,13,0">
                    <FontIcon Glyph="&#xE734;" FontSize="9" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </Grid>
            <Border Height="1" Background="{ThemeResource WorkspaceStrokeBrush}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RailItems" Spacing="4" Margin="0,14,0,0" HorizontalAlignment="Center">
                <Button Click="SelectRailItem" Style="{StaticResource RailButtonStyle}" Tag="采集" AutomationProperties.AutomationId="AcquisitionNavigation" AutomationProperties.Name="采集" ToolTipService.ToolTip="概览"><FontIcon Glyph="&#xE80A;" FontSize="19" /></Button>
                <Button x:Name="SelectedRailItem" Click="SelectRailItem" Style="{StaticResource RailButtonStyle}" Background="{ThemeResource RailSelectedBackgroundBrush}" Foreground="{ThemeResource RailAccentBrush}" Tag="设备" AutomationProperties.AutomationId="DeviceNavigation" AutomationProperties.Name="设备" ToolTipService.ToolTip="设备"><FontIcon Foreground="{ThemeResource RailAccentBrush}" Glyph="&#xE8A5;" FontSize="19" /></Button>
                <Button Click="SelectRailItem" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="成员" ToolTipService.ToolTip="成员"><FontIcon Glyph="&#xE716;" FontSize="19" /></Button>
                <Button Click="SelectRailItem" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="连接" ToolTipService.ToolTip="连接"><FontIcon Glyph="&#xE701;" FontSize="19" /></Button>
                <Button Click="SelectRailItem" Style="{StaticResource RailButtonStyle}" Tag="算法" AutomationProperties.AutomationId="AlgorithmNavigation" AutomationProperties.Name="数据分析" ToolTipService.ToolTip="数据分析"><FontIcon Glyph="&#xE9F9;" FontSize="19" /></Button>
                <Button Click="SelectRailItem" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="统计" ToolTipService.ToolTip="统计"><FontIcon Glyph="&#xE9D9;" FontSize="19" /></Button>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="2">
            <Border Height="1" Background="{ThemeResource WorkspaceStrokeBrush}" Margin="0,0,0,10" />
            <Grid>
                <Button Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="通知" ToolTipService.ToolTip="通知"><FontIcon Glyph="&#xE7F4;" FontSize="18" Foreground="{ThemeResource RailForegroundBrush}" /></Button>
            </Grid>
            <Button Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置"><FontIcon Glyph="&#xE713;" FontSize="18" Foreground="{ThemeResource RailForegroundBrush}" /></Button>
            <Button Style="{StaticResource RailButtonStyle}" Click="ToggleTheme" AutomationProperties.AutomationId="ThemeButton" AutomationProperties.Name="切换主题" ToolTipService.ToolTip="切换深色/浅色模式"><FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="18" /></Button>
            <ToggleSwitch x:Name="ThemeSwitch" Width="40" MinWidth="0" Padding="0" HorizontalAlignment="Center" Margin="0,2,0,12" OffContent="{x:Null}" OnContent="{x:Null}" Toggled="ThemeToggled" AutomationProperties.AutomationId="ThemeSwitch" AutomationProperties.Name="深色模式" />
            <Border Height="1" Background="{ThemeResource WorkspaceStrokeBrush}" />
            <Grid Margin="0,14,0,0">
                <Border Width="38" Height="38" CornerRadius="10" Background="{ThemeResource RailSelectedBackgroundBrush}" HorizontalAlignment="Center"><PersonPicture DisplayName="EMT" Width="32" Height="32" /></Border>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
