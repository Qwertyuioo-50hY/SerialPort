<UserControl x:Class="Tomography.UI.SideView.IconRailView" x:Name="RailRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RailButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource RailForegroundBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid Padding="0,12,0,8" CornerRadius="{Binding CornerRadius, ElementName=RailRoot}" Background="{ThemeResource ShellBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Spacing="10">
            <Image Source="ms-appx:///Assets/BrandAppIcon.png" Width="32" Height="46" Stretch="Uniform" HorizontalAlignment="Center" AutomationProperties.Name="FieldSync Logo" />
            <Button Style="{StaticResource RailButtonStyle}" Click="CollapseDirectory" AutomationProperties.AutomationId="CollapseDirectory" AutomationProperties.Name="折叠资源栏" ToolTipService.ToolTip="折叠资源栏"><Path Width="18" Height="15" Stretch="Uniform" Stroke="{ThemeResource RailForegroundBrush}" StrokeThickness="2" Data="M 0,3 L 13,3 M 0,10 L 13,10 M 0,17 L 13,17 M 16,3 L 23,10 L 16,17" /></Button>
            <Border Height="1" Background="{ThemeResource WorkspaceStrokeBrush}" />
            <Grid Height="64">
                <Border Width="40" Height="40" CornerRadius="12" Background="{ThemeResource RailSelectedBackgroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="G" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Width="15" Height="15" CornerRadius="8" Background="{ThemeResource RailAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,13,0">
                    <FontIcon Glyph="&#xE734;" FontSize="9" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
            </Grid>
            <Border Height="1" Background="{ThemeResource WorkspaceStrokeBrush}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RailItems" Spacing="4" Margin="0,14,0,0" HorizontalAlignment="Center">
                <Button Click="SelectRailItem" Style="{StaticResource RailButtonStyle}" Tag="主页" AutomationProperties.AutomationId="HomeNavigation" AutomationProperties.Name="主页" ToolTipService.ToolTip="主页"><FontIcon Glyph="&#xE80F;" FontSize="19" /></Button>
                <Button x:Name="SelectedRailItem" Click="SelectRailItem" Style="{StaticResource RailButtonStyle}" Background="{ThemeResource RailSelectedBackgroundBrush}" Foreground="{ThemeResource RailAccentBrush}" Tag="设备" AutomationProperties.AutomationId="DeviceNavigation" AutomationProperties.Name="设备" ToolTipService.ToolTip="设备"><Path Width="20" Height="20" Stretch="Uniform" Fill="{ThemeResource RailForegroundBrush}" Data="M6 2C4.89543 2 4 2.89543 4 4V20C4 21.1046 4.89543 22 6 22H18C19.1046 22 20 21.1046 20 20V9.82777C20 9.29733 19.7893 8.78863 19.4142 8.41355L13.5864 2.58579C13.2114 2.21071 12.7027 2 12.1722 2H6ZM5.5 4C5.5 3.72386 5.72386 3.5 6 3.5H12V8C12 9.10457 12.8954 10 14 10H18.5V20C18.5 20.2761 18.2761 20.5 18 20.5H6C5.72386 20.5 5.5 20.2761 5.5 20V4ZM17.3793 8.5H14C13.7239 8.5 13.5 8.27614 13.5 8V4.62066L17.3793 8.5Z"/></Button>
                <Button Click="SelectRailItem" Style="{StaticResource RailButtonStyle}" Tag="算法" AutomationProperties.AutomationId="AlgorithmNavigation" AutomationProperties.Name="数据分析" ToolTipService.ToolTip="数据分析"><Path Width="20" Height="20" Stretch="Uniform" Fill="{ThemeResource RailForegroundBrush}" Data="M4 3C4.55228 3 5 3.44772 5 4V17.5C5 18.3284 5.67157 19 6.5 19H20C20.5523 19 21 19.4477 21 20C21 20.5523 20.5523 21 20 21H6.5C4.567 21 3 19.433 3 17.5V4C3 3.44772 3.44772 3 4 3ZM17 4C15.3431 4 14 5.34315 14 7C14 8.65685 15.3431 10 17 10C18.6569 10 20 8.65685 20 7C20 5.34315 18.6569 4 17 4ZM6 9C6 7.34315 7.34315 6 9 6C10.6569 6 12 7.34315 12 9C12 10.6569 10.6569 12 9 12C7.34315 12 6 10.6569 6 9ZM12 15C12 13.3431 13.3431 12 15 12C16.6569 12 18 13.3431 18 15C18 16.6569 16.6569 18 15 18C13.3431 18 12 16.6569 12 15Z"/></Button>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Spacing="2">
            <Border Height="1" Background="{ThemeResource WorkspaceStrokeBrush}" Margin="0,0,0,10" />
            <Grid>
                <Button x:Name="AiRailItem" Click="SelectRailItem" Tag="AI" Style="{StaticResource RailButtonStyle}" AutomationProperties.AutomationId="AiNavigation" AutomationProperties.Name="AI" ToolTipService.ToolTip="AI 聊天"><Path Width="20" Height="20" Stretch="Uniform" Fill="{ThemeResource RailForegroundBrush}" Data="M12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22C10.3817 22 8.81782 21.6146 7.41286 20.888L3.58704 21.9553C2.92212 22.141 2.23258 21.7525 2.04691 21.0876C1.98546 20.8676 1.98549 20.6349 2.04695 20.4151L3.11461 16.5922C2.38637 15.186 2 13.6203 2 12C2 6.47715 6.47715 2 12 2ZM12 3.5C7.30558 3.5 3.5 7.30558 3.5 12C3.5 13.4696 3.87277 14.8834 4.57303 16.1375L4.72368 16.4072L3.61096 20.3914L7.59755 19.2792L7.86709 19.4295C9.12006 20.1281 10.5322 20.5 12 20.5C16.6944 20.5 20.5 16.6944 20.5 12C20.5 7.30558 16.6944 3.5 12 3.5ZM8.75 13H13.2483C13.6625 13 13.9983 13.3358 13.9983 13.75C13.9983 14.1297 13.7161 14.4435 13.35 14.4932L13.2483 14.5H8.75C8.33579 14.5 8 14.1642 8 13.75C8 13.3703 8.28215 13.0565 8.64823 13.0068L8.75 13H13.2483H8.75ZM8.75 9.5H15.2545C15.6687 9.5 16.0045 9.83579 16.0045 10.25C16.0045 10.6297 15.7223 10.9435 15.3563 10.9932L15.2545 11H8.75C8.33579 11 8 10.6642 8 10.25C8 9.8703 8.28215 9.55651 8.64823 9.50685L8.75 9.5H15.2545H8.75Z"/></Button>
            </Grid>
            <Button x:Name="SettingsRailItem" Click="SelectRailItem" Tag="设置" Style="{StaticResource RailButtonStyle}" AutomationProperties.AutomationId="SettingsNavigation" AutomationProperties.Name="设置" ToolTipService.ToolTip="设置"><Path Width="20" Height="20" Stretch="Uniform" Fill="{ThemeResource RailForegroundBrush}" Data="M12.0122 2.25C12.7462 2.25846 13.4773 2.34326 14.1937 2.50304C14.5064 2.57279 14.7403 2.83351 14.7758 3.15196L14.946 4.67881C15.0231 5.37986 15.615 5.91084 16.3206 5.91158C16.5103 5.91188 16.6979 5.87238 16.8732 5.79483L18.2738 5.17956C18.5651 5.05159 18.9055 5.12136 19.1229 5.35362C20.1351 6.43464 20.8889 7.73115 21.3277 9.14558C21.4223 9.45058 21.3134 9.78203 21.0564 9.9715L19.8149 10.8866C19.4607 11.1468 19.2516 11.56 19.2516 11.9995C19.2516 12.4389 19.4607 12.8521 19.8157 13.1129L21.0582 14.0283C21.3153 14.2177 21.4243 14.5492 21.3297 14.8543C20.8911 16.2685 20.1377 17.5649 19.1261 18.6461C18.9089 18.8783 18.5688 18.9483 18.2775 18.8206L16.8712 18.2045C16.4688 18.0284 16.0068 18.0542 15.6265 18.274C15.2463 18.4937 14.9933 18.8812 14.945 19.3177L14.7759 20.8444C14.741 21.1592 14.5122 21.4182 14.204 21.4915C12.7556 21.8361 11.2465 21.8361 9.79803 21.4915C9.48991 21.4182 9.26105 21.1592 9.22618 20.8444L9.05736 19.32C9.00777 18.8843 8.75434 18.498 8.37442 18.279C7.99451 18.06 7.5332 18.0343 7.1322 18.2094L5.72557 18.8256C5.43422 18.9533 5.09403 18.8833 4.87678 18.6509C3.86462 17.5685 3.11119 16.2705 2.6732 14.8548C2.57886 14.5499 2.68786 14.2186 2.94485 14.0293L4.18818 13.1133C4.54232 12.8531 4.75147 12.4399 4.75147 12.0005C4.75147 11.561 4.54232 11.1478 4.18771 10.8873L2.94516 9.97285C2.6878 9.78345 2.5787 9.45178 2.67337 9.14658C3.11212 7.73215 3.86594 6.43564 4.87813 5.35462C5.09559 5.12236 5.43594 5.05259 5.72724 5.18056L7.12762 5.79572C7.53056 5.97256 7.9938 5.94585 8.37577 5.72269C8.75609 5.50209 9.00929 5.11422 9.05817 4.67764L9.22824 3.15196C9.26376 2.83335 9.49786 2.57254 9.8108 2.50294C10.5281 2.34342 11.26 2.25865 12.0122 2.25ZM12.0124 3.7499C11.5583 3.75524 11.1056 3.79443 10.6578 3.86702L10.5489 4.84418C10.4471 5.75368 9.92003 6.56102 9.13042 7.01903C8.33597 7.48317 7.36736 7.53903 6.52458 7.16917L5.62629 6.77456C5.05436 7.46873 4.59914 8.25135 4.27852 9.09168L5.07632 9.67879C5.81513 10.2216 6.25147 11.0837 6.25147 12.0005C6.25147 12.9172 5.81513 13.7793 5.0771 14.3215L4.27805 14.9102C4.59839 15.752 5.05368 16.5361 5.626 17.2316L6.53113 16.8351C7.36923 16.4692 8.33124 16.5227 9.12353 16.9794C9.91581 17.4361 10.4443 18.2417 10.548 19.1526L10.657 20.1365C11.5466 20.2878 12.4555 20.2878 13.3451 20.1365L13.4541 19.1527C13.5549 18.2421 14.0828 17.4337 14.876 16.9753C15.6692 16.5168 16.6332 16.463 17.4728 16.8305L18.3772 17.2267C18.949 16.5323 19.4041 15.7495 19.7247 14.909L18.9267 14.3211C18.1879 13.7783 17.7516 12.9162 17.7516 11.9995C17.7516 11.0827 18.1879 10.2206 18.9258 9.67847L19.7227 9.09109C19.4021 8.25061 18.9468 7.46784 18.3748 6.77356L17.4783 7.16737C17.113 7.32901 16.7178 7.4122 16.3187 7.41158C14.849 7.41004 13.6155 6.30355 13.4551 4.84383L13.3462 3.8667C12.9007 3.7942 12.4526 3.75512 12.0124 3.7499ZM11.9997 8.24995C14.0708 8.24995 15.7497 9.92888 15.7497 12C15.7497 14.071 14.0708 15.75 11.9997 15.75C9.92863 15.75 8.2497 14.071 8.2497 12C8.2497 9.92888 9.92863 8.24995 11.9997 8.24995ZM11.9997 9.74995C10.7571 9.74995 9.7497 10.7573 9.7497 12C9.7497 13.2426 10.7571 14.25 11.9997 14.25C13.2423 14.25 14.2497 13.2426 14.2497 12C14.2497 10.7573 13.2423 9.74995 11.9997 9.74995Z"/></Button>
            <Button Style="{StaticResource RailButtonStyle}" AutomationProperties.AutomationId="MainLanguage" AutomationProperties.Name="语言"><FontIcon Glyph="&#xE774;" FontSize="18"/><Button.Flyout><MenuFlyout Placement="RightEdgeAlignedBottom"><RadioMenuFlyoutItem x:Name="ChineseOption" Text="简体中文" Click="ChineseClicked" GroupName="MainLanguage" AutomationProperties.AutomationId="MainChinese"/><RadioMenuFlyoutItem x:Name="EnglishOption" Text="English" Click="EnglishClicked" GroupName="MainLanguage" AutomationProperties.AutomationId="MainEnglish"/></MenuFlyout></Button.Flyout></Button>
            <Border Height="1" Background="{ThemeResource WorkspaceStrokeBrush}" Margin="0,6"/>
            <Button Style="{StaticResource RailButtonStyle}" Click="ToggleTheme" AutomationProperties.AutomationId="ThemeButton" AutomationProperties.Name="切换主题" ToolTipService.ToolTip="切换深色/浅色模式"><FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="18" /></Button>
            <ToggleSwitch x:Name="ThemeSwitch" Width="40" MinWidth="0" Padding="0" HorizontalAlignment="Center" Margin="0,2,0,12" OffContent="{x:Null}" OnContent="{x:Null}" Toggled="ThemeToggled" AutomationProperties.AutomationId="ThemeSwitch" AutomationProperties.Name="深色模式" />
            <Border Height="1" Background="{ThemeResource WorkspaceStrokeBrush}" />
            <Grid Margin="0,14,0,0">
                <Button x:Name="AccountButton" Style="{StaticResource RailButtonStyle}" AutomationProperties.Name="账号" AutomationProperties.AutomationId="AccountMenu">
                    <PersonPicture x:Name="AccountPicture" Width="32" Height="32"/>
                    <Button.Flyout>
                     <Flyout x:Name="AccountFlyout" Placement="RightEdgeAlignedBottom">
                      <Flyout.FlyoutPresenterStyle><Style TargetType="FlyoutPresenter"><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="12"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="{ThemeResource DevicePageBrush}"/></Style></Flyout.FlyoutPresenterStyle>
                      <StackPanel Width="184" Spacing="2">
                       <StackPanel.Resources><Style TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="10,7"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/></Style></StackPanel.Resources>
                       <Button Click="AccountProfileClicked" AutomationProperties.AutomationId="SwitchAccount"><StackPanel Orientation="Horizontal" Spacing="12"><PersonPicture x:Name="MenuAccountPicture" Width="26" Height="26"/><TextBlock x:Name="MenuAccountName" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="125" FontSize="14" FontWeight="SemiBold"/></StackPanel></Button>
                       <Border Height="1" Margin="8" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                       <Button Click="AccountThemeClicked" AutomationProperties.AutomationId="AccountTheme"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE790;" FontSize="18"/><TextBlock Text="主题" FontSize="13"/></StackPanel></Button>
                       <Button Click="AccountSettingsClicked" AutomationProperties.AutomationId="AccountSettings"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="18"/><TextBlock Text="设置" FontSize="13"/></StackPanel></Button>
                       <Border Height="1" Margin="8" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                       <Button Click="AccountHelpClicked" AutomationProperties.AutomationId="AccountHelp"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE897;" FontSize="18"/><TextBlock Text="帮助" FontSize="13"/></StackPanel></Button>
                       <Button Click="AccountSignOutClicked" AutomationProperties.AutomationId="SignOut"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8AC;" FontSize="18"/><TextBlock Text="退出登录" FontSize="13"/></StackPanel></Button>
                      </StackPanel>
                     </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
