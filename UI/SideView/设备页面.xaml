<UserControl x:Class="Tomography.UI.SideView.DevicePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Tomography.UI.SideView">
 <UserControl.Resources>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="Button"><Setter Property="CornerRadius" Value="12"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="ComboBox"><Setter Property="CornerRadius" Value="12"/></Style>
  <Style TargetType="NumberBox"><Setter Property="CornerRadius" Value="12"/></Style>
  <Style x:Key="Module" TargetType="Border"><Setter Property="Background" Value="{ThemeResource DeviceToolbarBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource DeviceDividerBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="20"/><Setter Property="Padding" Value="24"/></Style>
 </UserControl.Resources>
 <Border Background="{ThemeResource DevicePageBrush}" CornerRadius="24">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
   <StackPanel Margin="24" Spacing="20">
    <StackPanel Orientation="Horizontal" Spacing="10">
     <Button x:Name="ConnectButton" Click="ConnectClicked" Style="{StaticResource AccentButtonStyle}" CornerRadius="12" AutomationProperties.AutomationId="DeviceConnect"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE839;" FontSize="15"/><TextBlock Text="连接" FontWeight="SemiBold"/></StackPanel></Button>
     <Button x:Name="HandshakeButton" Click="HandshakeClicked" IsEnabled="False" AutomationProperties.AutomationId="DeviceHandshake"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8D4;" FontSize="15"/><TextBlock Text="握手"/></StackPanel></Button>
     <Button x:Name="DisconnectButton" Click="DisconnectClicked" IsEnabled="False" AutomationProperties.AutomationId="DeviceDisconnect"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE711;" FontSize="15"/><TextBlock Text="断开"/></StackPanel></Button>
     <ProgressRing x:Name="Progress" Width="18" Height="18" IsActive="False"/>
    </StackPanel>
    <TextBlock x:Name="Status" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.AutomationId="DeviceStatus"/>
    <InfoBar x:Name="Error" IsOpen="False" Severity="Error" AutomationProperties.AutomationId="DeviceError"><TextBlock x:Name="ErrorDetails" TextWrapping="Wrap"/></InfoBar>
    <Grid ColumnSpacing="20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Module}"><ContentControl x:Name="ConnectionHost" HorizontalContentAlignment="Stretch"/></Border>
     <Border Grid.Column="1" Style="{StaticResource Module}"><StackPanel Spacing="20"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE713;" FontSize="18"/><TextBlock Text="接口参数" FontSize="18" FontWeight="SemiBold"/></StackPanel><ContentControl x:Name="TransportParametersHost" HorizontalContentAlignment="Stretch"/></StackPanel></Border>
    </Grid>
    <Grid ColumnSpacing="20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Style="{StaticResource Module}">
      <StackPanel Spacing="20">
       <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE950;" FontSize="18"/><TextBlock Text="设备参数" FontSize="18" FontWeight="SemiBold"/></StackPanel>
       <ContentControl x:Name="ParametersHost" HorizontalContentAlignment="Stretch"/>
       <Border Height="1" Background="{ThemeResource DeviceDividerBrush}"/>
       <Button Tag="灵敏度矩阵" Click="ImportClicked" HorizontalAlignment="Left" AutomationProperties.AutomationId="ImportSensitivity"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE8B5;" FontSize="16"/><TextBlock Text="灵敏度矩阵" FontWeight="SemiBold"/></StackPanel></Button>
       <TextBlock x:Name="MatrixFile" Text="未导入灵敏度矩阵" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="SensitivityStatus"/>
       <TextBlock x:Name="ImportStatus" Visibility="Collapsed" FontSize="12" AutomationProperties.AutomationId="SensitivityImportResult"/>
      </StackPanel>
     </Border>
     <Border Grid.Column="1" Style="{StaticResource Module}"><local:ReceivedDataView x:Name="ReceivedData"/></Border>
    </Grid>
    <Border Style="{StaticResource Module}"><local:FrameSettingsView x:Name="FrameSettings"/></Border>
   </StackPanel>
  </ScrollViewer>
 </Border>
</UserControl>
