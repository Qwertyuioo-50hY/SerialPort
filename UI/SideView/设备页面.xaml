<UserControl x:Class="Tomography.UI.SideView.DevicePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style TargetType="TextBlock"><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="Button"><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="ComboBox"><Setter Property="CornerRadius" Value="10"/></Style>
  <Style TargetType="NumberBox"><Setter Property="CornerRadius" Value="10"/></Style>
 </UserControl.Resources>
 <Border Background="{ThemeResource DevicePageBrush}" CornerRadius="24">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
   <StackPanel Margin="24,32,24,24" Spacing="16">
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button x:Name="ConnectButton" Content="连接" Click="ConnectClicked" Style="{StaticResource AccentButtonStyle}" CornerRadius="10" AutomationProperties.AutomationId="DeviceConnect"/>
     <Button x:Name="HandshakeButton" Content="握手" Click="HandshakeClicked" IsEnabled="False" AutomationProperties.AutomationId="DeviceHandshake"/>
     <Button x:Name="DisconnectButton" Content="断开" Click="DisconnectClicked" IsEnabled="False" AutomationProperties.AutomationId="DeviceDisconnect"/>
     <ProgressRing x:Name="Progress" Width="16" Height="16" IsActive="False"/>
    </StackPanel>
    <TextBlock x:Name="Status" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.AutomationId="DeviceStatus"/>
    <InfoBar x:Name="Error" IsOpen="False" Severity="Error" AutomationProperties.AutomationId="DeviceError"/>
    <Border Background="{ThemeResource DeviceToolbarBrush}" BorderBrush="{ThemeResource DeviceDividerBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
     <ContentControl x:Name="ConnectionHost" HorizontalContentAlignment="Stretch"/>
    </Border>
    <Grid x:Name="Modules" ColumnSpacing="16" RowSpacing="16" SizeChanged="ModulesSizeChanged">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="ParametersColumn"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{ThemeResource DeviceToolbarBrush}" BorderBrush="{ThemeResource DeviceDividerBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
      <ContentControl x:Name="TransportParametersHost" HorizontalContentAlignment="Stretch"/>
     </Border>
     <Border x:Name="DeviceParametersModule" Grid.Column="1" Background="{ThemeResource DeviceToolbarBrush}" BorderBrush="{ThemeResource DeviceDividerBrush}" BorderThickness="1" CornerRadius="16" Padding="20" VerticalAlignment="Top">
      <StackPanel Spacing="20">
       <ContentControl x:Name="ParametersHost" HorizontalContentAlignment="Stretch"/>
       <StackPanel x:Name="SimulationRow" Visibility="Collapsed" Spacing="12">
        <TextBlock x:Name="SimulationFile" Text="未导入仿真数据" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="选择数据" Tag="物场/Demo数据" Click="ImportClicked" AutomationProperties.AutomationId="ImportSimulation"/><Button Content="空场参考" Tag="空场参考" Click="ImportClicked" AutomationProperties.AutomationId="ImportReference"/></StackPanel>
       </StackPanel>
       <Border Height="1" Background="{ThemeResource DeviceDividerBrush}"/>
       <TextBlock x:Name="MatrixFile" Text="未导入灵敏度矩阵" TextWrapping="Wrap" AutomationProperties.AutomationId="SensitivityStatus"/>
       <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="选择 / 更换矩阵" Tag="灵敏度矩阵" Click="ImportClicked" AutomationProperties.AutomationId="ImportSensitivity"/>
        <Button Content="移除" Click="RemoveClicked" AutomationProperties.AutomationId="RemoveSensitivity"/>
       </StackPanel>
       <TextBlock x:Name="CoordinatesFile" Visibility="Collapsed" TextWrapping="Wrap"/>
       <Button Content="选择节点坐标" Tag="节点坐标" Click="ImportClicked" HorizontalAlignment="Left" AutomationProperties.AutomationId="ImportCoordinates"/>
       <Border Height="1" Background="{ThemeResource DeviceDividerBrush}"/>
       <Button Content="诊断日志" Click="DiagnosticsClicked" HorizontalAlignment="Left" AutomationProperties.AutomationId="DeviceDiagnostics"/>
       <Button Content="编辑自定义帧定义" Click="ProtocolClicked" HorizontalAlignment="Left" AutomationProperties.AutomationId="EditDeviceProtocol"/>
      </StackPanel>
     </Border>
    </Grid>
   </StackPanel>
  </ScrollViewer>
 </Border>
</UserControl>
