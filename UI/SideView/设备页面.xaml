<UserControl x:Class="Tomography.UI.SideView.DevicePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{ThemeResource DevicePageBrush}" CornerRadius="14">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
   <StackPanel MaxWidth="1060" HorizontalAlignment="Stretch" Margin="24" Spacing="20">
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="设备" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <Button Grid.Column="1" Click="RefreshClicked" ToolTipService.ToolTip="刷新串口" AutomationProperties.Name="刷新串口" AutomationProperties.AutomationId="DeviceRefresh"><FontIcon Glyph="&#xE72C;" FontSize="16"/></Button>
     <Button x:Name="ConnectButton" Grid.Column="2" Content="连接" Click="ConnectClicked" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="DeviceConnect"/>
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="8"><ProgressRing x:Name="Progress" Width="16" Height="16" IsActive="False"/><TextBlock x:Name="Status" Text="未连接" TextWrapping="Wrap" AutomationProperties.AutomationId="DeviceStatus"/></StackPanel>
    <InfoBar x:Name="Error" IsOpen="False" Severity="Error" AutomationProperties.AutomationId="DeviceError"/>
    <ContentControl x:Name="ConnectionHost"/>
    <Border Height="1" Background="{ThemeResource DeviceDividerBrush}"/>
    <TextBlock Text="EMT" FontWeight="SemiBold"/>
    <ContentControl x:Name="ParametersHost"/>
    <TextBlock x:Name="ParameterStatus" Text="参数仅保存于本项目；尚未由下位机采样应答确认。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <StackPanel x:Name="SimulationRow" Visibility="Collapsed" Spacing="8">
     <Border Height="1" Background="{ThemeResource DeviceDividerBrush}"/>
     <TextBlock Text="仿真数据" FontWeight="SemiBold"/>
     <TextBlock x:Name="SimulationFile" Text="未导入：需要 64 个有限通道值" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="选择数据" Tag="物场/Demo数据" Click="ImportClicked" AutomationProperties.AutomationId="ImportSimulation"/><Button Content="空场参考" Tag="空场参考" Click="ImportClicked" AutomationProperties.AutomationId="ImportReference"/></StackPanel>
    </StackPanel>
    <Border Height="1" Background="{ThemeResource DeviceDividerBrush}"/>
    <TextBlock Text="灵敏度矩阵" FontWeight="SemiBold"/>
    <TextBlock x:Name="MatrixFile" Text="未导入灵敏度矩阵" TextWrapping="Wrap" AutomationProperties.AutomationId="SensitivityStatus"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="选择 / 更换文件" Tag="灵敏度矩阵" Click="ImportClicked" AutomationProperties.AutomationId="ImportSensitivity"/>
     <Button Content="移除" Click="RemoveClicked" AutomationProperties.AutomationId="RemoveSensitivity"/>
    </StackPanel>
    <TextBlock x:Name="CoordinatesFile" Text="CSV 矩阵需另导入 N×2 节点坐标；MAT 需包含 sen 和 xy。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Button Content="选择节点坐标" Tag="节点坐标" Click="ImportClicked" HorizontalAlignment="Left" AutomationProperties.AutomationId="ImportCoordinates"/>
    <Button Content="更多" HorizontalAlignment="Left" AutomationProperties.AutomationId="DeviceMore">
     <Button.Flyout><MenuFlyout><MenuFlyoutItem Text="诊断日志" Click="DiagnosticsClicked"/><MenuFlyoutItem Text="编辑自定义帧定义" Click="ProtocolClicked"/></MenuFlyout></Button.Flyout>
    </Button>
   </StackPanel>
  </ScrollViewer>
 </Border>
</UserControl>
