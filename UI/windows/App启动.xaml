<Application x:Class="Tomography.UI.windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="DevicePageBrush" Color="#1D1D1D" />
                    <SolidColorBrush x:Key="DeviceCanvasBrush" Color="#161616" />
                    <SolidColorBrush x:Key="DeviceToolbarBrush" Color="#161616" />
                    <SolidColorBrush x:Key="DeviceDividerBrush" Color="#333333" />
                    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#101010" />
                    <SolidColorBrush x:Key="RailForegroundBrush" Color="#858585" />
                    <SolidColorBrush x:Key="RailSelectedBackgroundBrush" Color="#252525" />
                    <SolidColorBrush x:Key="RailAccentBrush" Color="#18B568" />
                    <SolidColorBrush x:Key="LogoPlateBrush" Color="#F1F0ED" />
                    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#1D1D1D" />
                    <SolidColorBrush x:Key="ParameterBackgroundBrush" Color="#1D1D1D" />
                    <SolidColorBrush x:Key="WorkspaceStrokeBrush" Color="#2B2B2B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="DevicePageBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="DeviceCanvasBrush" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="DeviceToolbarBrush" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="DeviceDividerBrush" Color="#E7E9ED" />
                    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#101010" />
                    <SolidColorBrush x:Key="RailForegroundBrush" Color="#858585" />
                    <SolidColorBrush x:Key="RailSelectedBackgroundBrush" Color="#252525" />
                    <SolidColorBrush x:Key="RailAccentBrush" Color="#18B568" />
                    <SolidColorBrush x:Key="LogoPlateBrush" Color="#F1F0ED" />
                    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#1D1D1D" />
                    <SolidColorBrush x:Key="ParameterBackgroundBrush" Color="#1D1D1D" />
                    <SolidColorBrush x:Key="WorkspaceStrokeBrush" Color="#2B2B2B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="DevicePageBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DeviceCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DeviceToolbarBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DeviceDividerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="RailForegroundBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="RailSelectedBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="RailAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="LogoPlateBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ParameterBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WorkspaceStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
            <x:Double x:Key="TextControlThemeFontSize">12</x:Double>
            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            </Style>
            <Style x:Key="WorkspaceHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="WorkspaceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WorkspaceBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceStrokeBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="24" />
                <Setter Property="Padding" Value="20" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
