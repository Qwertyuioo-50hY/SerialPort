<Application x:Class="Tomography.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#181818" />
                    <SolidColorBrush x:Key="ParameterBackgroundBrush" Color="#161616" />
                    <SolidColorBrush x:Key="WorkspaceStrokeBrush" Color="#333333" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#181818" />
                    <SolidColorBrush x:Key="ParameterBackgroundBrush" Color="#161616" />
                    <SolidColorBrush x:Key="WorkspaceStrokeBrush" Color="#333333" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="ParameterBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="WorkspaceStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
            <x:Double x:Key="TextControlThemeFontSize">12</x:Double>
            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
            </Style>
            <Style x:Key="WorkspaceHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="WorkspaceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource WorkspaceBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource WorkspaceStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
