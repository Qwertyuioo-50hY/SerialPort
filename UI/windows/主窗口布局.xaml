<Window x:Class="Tomography.UI.windows.AppWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tomography.UI.windows"
    xmlns:side="using:Tomography.UI.SideView"
    xmlns:navigation="using:Tomography.UI.Navigation"
    xmlns:workspace="using:Tomography.UI.workspace" Title="Tomography">
    <Grid x:Name="Root" Background="#080808" RequestedTheme="Light" Loaded="RootLoaded" SizeChanged="RootSizeChanged">
        <Grid.Resources>
            <Style x:Key="DividerStyle" TargetType="Thumb">
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Highlight.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Highlight.Opacity" Value="0.6" /></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Highlight" Width="2" Opacity="0" Background="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Border x:Name="ShellFrame" Margin="0" BorderBrush="#080808" BorderThickness="8" CornerRadius="8" Background="{ThemeResource DeviceCanvasBrush}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition x:Name="DirectoryColumn" Width="260"/><ColumnDefinition x:Name="DirectoryDividerColumn" Width="8"/><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <side:IconRailView x:Name="SideRail" CornerRadius="8" RequestedTheme="Dark" Margin="8,8,0,8" />
                <Border x:Name="DirectoryFrame" Grid.Column="1" Background="{ThemeResource DevicePageBrush}" CornerRadius="24" Margin="8,8,0,8"><navigation:ProjectDirectoryView x:Name="DirectoryPanel"/></Border>
                <local:ResizeDivider x:Name="DirectoryDivider" Grid.Column="2" Width="8">
                    <Thumb Style="{StaticResource DividerStyle}" DragDelta="DirectoryDragDelta" AutomationProperties.Name="调整项目导航宽度"/>
                </local:ResizeDivider>
                <Grid x:Name="DeviceShell" Grid.Column="3" Background="{ThemeResource DeviceCanvasBrush}" ColumnSpacing="8" Padding="0,8,8,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                    <side:DevicePage x:Name="DeviceView"/>
                </Grid>
                <Grid x:Name="ContentGrid" Grid.Column="3" Margin="0,8,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ParameterColumn" Width="294" />
                        <ColumnDefinition x:Name="DividerColumn" Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ParameterPanel" Style="{StaticResource WorkspaceCardStyle}"
                        Visibility="{x:Bind local:AppWindow.BoolToVisibility(ViewModel.ParametersVisible), Mode=OneWay}">
                        <Grid RowSpacing="20">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{ThemeResource RailAccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Section, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ParameterBody" Spacing="12" /></ScrollViewer>
                        </Grid>
                    </Border>
                    <local:ResizeDivider Grid.Column="1" Width="8" Visibility="{x:Bind local:AppWindow.BoolToVisibility(ViewModel.ParametersVisible), Mode=OneWay}">
                        <Thumb x:Name="ParameterDivider" Style="{StaticResource DividerStyle}" DragDelta="ParameterDragDelta"
                            KeyDown="ParameterDividerKeyDown" AutomationProperties.Name="调整侧边栏宽度" />
                    </local:ResizeDivider>
                    <Grid Grid.Column="2">
                        <ScrollViewer x:Name="WorkspaceScroll" ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
                            <workspace:ImagingWorkspaceView x:Name="Workspace">
                                <workspace:ImagingWorkspaceView.Commands>
                                    <StackPanel x:Name="ToolsPanel" Visibility="Collapsed" Orientation="Horizontal" Spacing="6">
                                        <Button Content="空场" Tag="Reference" Click="AcquisitionButtonClicked" AutomationProperties.AutomationId="AcquireReference"/>
                                        <Button Content="单次" Tag="Single" Click="AcquisitionButtonClicked" AutomationProperties.AutomationId="AcquireSingle"/>
                                        <Button Content="连续" Tag="Live" Click="AcquisitionButtonClicked" AutomationProperties.AutomationId="AcquireLive"/>
                                        <Button Content="停止" Tag="Stop" Click="AcquisitionButtonClicked" AutomationProperties.AutomationId="StopAcquisition"/>
                                    </StackPanel>
                                </workspace:ImagingWorkspaceView.Commands>
                            </workspace:ImagingWorkspaceView>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>
        </Border>
        <StackPanel Margin="8,8,8,0" VerticalAlignment="Top" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
            <Button Content="&#xE921;" Tag="Minimize" Click="DeviceWindowCommand" FontFamily="{ThemeResource SymbolThemeFontFamily}" Background="Transparent" BorderThickness="0" Padding="8" AutomationProperties.Name="最小化" AutomationProperties.AutomationId="DeviceMinimize"/>
            <Button Content="&#xE922;" Tag="Maximize" Click="DeviceWindowCommand" FontFamily="{ThemeResource SymbolThemeFontFamily}" Background="Transparent" BorderThickness="0" Padding="8" AutomationProperties.Name="最大化或还原" AutomationProperties.AutomationId="DeviceMaximize"/>
            <Button Content="&#xE8BB;" Tag="Close" Click="DeviceWindowCommand" FontFamily="{ThemeResource SymbolThemeFontFamily}" Background="Transparent" BorderThickness="0" Padding="8" AutomationProperties.Name="关闭" AutomationProperties.AutomationId="DeviceClose"/>
        </StackPanel>
        <Grid x:Name="WindowDragRegion" Height="12" Margin="88,0,12,0" VerticalAlignment="Top" Background="Transparent" />
    </Grid>
</Window>
