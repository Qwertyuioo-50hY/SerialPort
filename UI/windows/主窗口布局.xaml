<Window x:Class="Tomography.UI.windows.AppWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Tomography.UI.windows"
    xmlns:side="using:Tomography.UI.SideView"
    xmlns:navigation="using:Tomography.UI.Navigation"
    xmlns:workspace="using:Tomography.UI.workspace" Title="Tomography">
    <Grid x:Name="Root" Background="{ThemeResource ShellBackgroundBrush}" RequestedTheme="Dark" Loaded="RootLoaded" SizeChanged="RootSizeChanged">
        <Grid.Resources>
            <Style x:Key="DividerStyle" TargetType="Thumb">
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Highlight.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                                        <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Highlight.Opacity" Value="0.6" /></VisualState.Setters></VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Highlight" Width="2" Opacity="0" Background="{ThemeResource TextFillColorPrimaryBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Border Margin="4" BorderBrush="#080808" BorderThickness="8" CornerRadius="32" Background="{ThemeResource ShellBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <side:IconRailView x:Name="SideRail" />
                <Grid x:Name="ContentGrid" Grid.Column="1" Margin="0,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ParameterColumn" Width="294" />
                        <ColumnDefinition x:Name="DividerColumn" Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition x:Name="ProjectColumn" Width="240" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ParameterPanel" Style="{StaticResource WorkspaceCardStyle}"
                        Visibility="{x:Bind local:AppWindow.BoolToVisibility(ViewModel.ParametersVisible), Mode=OneWay}">
                        <Grid RowSpacing="20">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{ThemeResource RailAccentBrush}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Section, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Grid>
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ParameterBody" Spacing="12" /></ScrollViewer>
                        </Grid>
                    </Border>
                    <local:ResizeDivider Grid.Column="1" Width="8" Visibility="{x:Bind local:AppWindow.BoolToVisibility(ViewModel.ParametersVisible), Mode=OneWay}">
                        <Thumb x:Name="ParameterDivider" Style="{StaticResource DividerStyle}" DragDelta="ParameterDragDelta"
                            KeyDown="ParameterDividerKeyDown" AutomationProperties.Name="调整侧边栏宽度" />
                    </local:ResizeDivider>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel x:Name="ToolsPanel" Visibility="Collapsed" Orientation="Horizontal" Spacing="6"><Button Content="连接" IsEnabled="False" /></StackPanel>
                        <ScrollViewer x:Name="WorkspaceScroll" Grid.Row="1" ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled">
                            <workspace:ImagingWorkspaceView x:Name="Workspace" />
                        </ScrollViewer>
                    </Grid>
                    <local:ResizeDivider Grid.Column="3" Width="8">
                        <Thumb Style="{StaticResource DividerStyle}" DragDelta="ProjectDragDelta" AutomationProperties.Name="调整项目导航宽度" />
                    </local:ResizeDivider>
                    <navigation:ImportedFilesView x:Name="ProjectPanel" Grid.Column="4" />
                </Grid>
            </Grid>
        </Border>
        <Grid x:Name="WindowDragRegion" Height="12" Margin="88,0,12,0" VerticalAlignment="Top" Background="Transparent" />
    </Grid>
</Window>
