<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\WindowsAppSdk.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tomography.UI</RootNamespace>
    <AssemblyName>Tomography</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.7.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <ProjectReference Include="..\Business\Business.csproj" />
    <ProjectReference Include="..\TitleBar\TitleBar.csproj" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <Content Include="Assets\*" />
    <Manifest Include="$(ApplicationManifest)" />
    <ProjectCapability Include="Msix" />
  </ItemGroup>
</Project>
