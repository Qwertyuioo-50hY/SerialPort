<UserControl x:Class="Tomography.UI.Home.HomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{ThemeResource DeviceCanvasBrush}" Padding="32,48,32,32">
  <Viewbox MaxWidth="580" MaxHeight="520" Margin="64" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
   <Image Source="ms-appx:///Assets/FieldSyncWatermark.svg" Width="360" Height="400" Opacity="0.16"/>
  </Viewbox>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel MaxWidth="800" HorizontalAlignment="Stretch" Spacing="32">
    <StackPanel Spacing="8" Margin="0,24,0,0">
     <TextBlock Text="欢迎使用 FieldSync" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeWelcome"/>
     <TextBlock Text="从一个项目开始，探索数据与成像。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <Button Click="NewProjectClicked" Padding="20,14" CornerRadius="12" AutomationProperties.Name="新建项目" AutomationProperties.AutomationId="HomeCreateProject">
     <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE710;" FontSize="18"/><TextBlock Text="新建项目" VerticalAlignment="Center"/></StackPanel>
    </Button>
    <StackPanel Spacing="12">
     <TextBlock Text="最近项目" Style="{StaticResource SubtitleTextBlockStyle}"/>
     <TextBlock x:Name="EmptyRecentProjects" Text="暂无最近项目。新建或打开项目后，将显示在这里。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="HomeEmptyRecent"/>
     <ListView x:Name="RecentProjects" SelectionMode="None" IsItemClickEnabled="True" ItemClick="RecentProjectClicked" Background="Transparent" AutomationProperties.Name="最近项目" AutomationProperties.AutomationId="HomeRecentProjects">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="12"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
       <DataTemplate>
        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <FontIcon Glyph="&#xE8B7;" FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
        </Grid>
       </DataTemplate>
      </ListView.ItemTemplate>
     </ListView>
    </StackPanel>
    <TextBlock x:Name="HomeStatus" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="HomeStatus"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
