<UserControl x:Class="Tomography.UI.Home.HomeView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="using:Tomography.Business.Services">
 <Grid Background="{ThemeResource DevicePageBrush}" Padding="32" CornerRadius="24" RowSpacing="32">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="24">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Welcome" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="HomeWelcome"/>
   <SplitButton Grid.Column="1" Click="CreateProjectSplitClicked" Background="#19B657" Foreground="White" CornerRadius="8" VerticalAlignment="Top" AutomationProperties.Name="新建项目或打开项目" AutomationProperties.AutomationId="HomeCreateProject">
    <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE710;" FontSize="16"/><TextBlock Text="新建项目"/></StackPanel>
    <SplitButton.Flyout><MenuFlyout><MenuFlyoutItem Text="新建项目" Icon="Add" Click="NewProjectClicked"/><MenuFlyoutItem Text="打开项目" Icon="OpenFile" Click="OpenProjectClicked" AutomationProperties.AutomationId="HomeOpenProject"/></MenuFlyout></SplitButton.Flyout>
   </SplitButton>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Spacing="16">
    <TextBlock x:Name="RecentHeading" Text="最近项目" Style="{StaticResource SubtitleTextBlockStyle}" Visibility="Collapsed"/>
     <ListView x:Name="RecentProjects" SelectionMode="None" IsItemClickEnabled="True" ItemClick="RecentProjectClicked" Background="Transparent" AutomationProperties.Name="最近项目" AutomationProperties.AutomationId="HomeRecentProjects">
      <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="12"/></Style></ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
       <DataTemplate>
        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <FontIcon Glyph="&#xE8B7;" FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
         <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
        </Grid>
       </DataTemplate>
      </ListView.ItemTemplate>
     </ListView>
    <TextBlock x:Name="ChatHeading" Text="最近聊天" Style="{StaticResource SubtitleTextBlockStyle}" Visibility="Collapsed" Margin="0,16,0,0"/>
    <ListView x:Name="RecentChats" SelectionMode="None" IsItemClickEnabled="True" ItemClick="RecentChatClicked" Background="Transparent" AutomationProperties.Name="最近聊天" AutomationProperties.AutomationId="HomeRecentChats">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="14"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate x:DataType="services:RecentChatEntry"><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8F2;" FontSize="24" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{x:Bind Title, Mode=OneTime}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{x:Bind Project, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
    </ListView>
   </StackPanel>
  </ScrollViewer>
  <TextBlock Grid.Row="2" x:Name="HomeStatus" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="HomeStatus"/>
 </Grid>
</UserControl>
